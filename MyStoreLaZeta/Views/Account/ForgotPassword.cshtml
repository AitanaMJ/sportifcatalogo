@model MyStoreLaZeta.Models.ForgotPasswordVM
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Recuperar Contraseña - La Zeta</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600;700&display=swap" />

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />

    <link rel="stylesheet" href="~/css/site.css" />

    <style>
        body {
            font-family: 'Poppins', sans-serif;
            background-color: #f8fbfb; 
        }

        .vh-100 {
            height: 100vh;
        }
    </style>
</head>
<body>

    <div class="container">
        <div class="row justify-content-center align-items-center vh-100">
            <div class="col-md-5 col-lg-4">

                <div class="card card-zeta shadow border-0 p-3">
                    <div class="card-body">

                        <div class="text-center mb-4">
                            <img src="~/images/logo_lazeta.png" alt="La Zeta Logo" style="height: 60px;" class="mb-3">
                            <div class="rounded-circle d-inline-flex align-items-center justify-content-center mb-3"
                                 style="width: 50px; height: 50px; background-color: rgba(23, 160, 156, 0.1);">
                                <i class="fa-solid fa-key fa-xl" style="color: var(--zeta-cyan);"></i>
                            </div>
                            <h3 class="fw-bold text-zeta-dark">¿Olvidaste tu clave?</h3>
                            <p class="text-muted small">Te enviaremos un enlace seguro para restablecerla.</p>
                        </div>

                        @if (ViewBag.Message != null)
                        {
                            <div class="alert alert-success border-0 shadow-sm text-center mb-4" role="alert">
                                <i class="fa-solid fa-paper-plane me-2"></i>
                                <small class="fw-bold">@ViewBag.Message</small>
                            </div>
                        }

                        <form asp-action="ForgotPassword" method="post">

                            <div class="mb-4">
                                <label class="form-label fw-bold text-zeta-dark">Email Registrado</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0">
                                        <i class="fa-solid fa-envelope text-muted"></i>
                                    </span>
                                    <input asp-for="Email" class="form-control border-start-0 ps-0 shadow-none"
                                           placeholder="nombre@ejemplo.com" />
                                </div>
                                <span asp-validation-for="Email" class="text-danger small fw-bold"></span>
                            </div>

                            <div class="d-grid gap-2 mt-4">
                                <button type="submit" class="btn btn-zeta-cyan py-2 shadow-sm fw-bold">
                                    ENVIAR ENLACE
                                </button>
                                <a asp-action="Login" class="btn btn-link text-decoration-none text-muted small mt-2">
                                    <i class="fa-solid fa-arrow-left me-1"></i> Volver al Iniciar Sesión
                                </a>
                            </div>

                        </form>
                    </div>
                </div>

                <div class="text-center mt-4 text-muted x-small">
                    <p>&copy; 2026 La Zeta Merchandising - Tucumán</p>
                </div>

            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>

</body>
</html>