@model CategoryVM

@{
    var title = Model.CategoryId == 0 ? "Nueva Categoría" : "Editar Categoría";
    var btnAction = Model.CategoryId == 0 ? "Agregar Categoría" : "Guardar Cambios";
    var icon = Model.CategoryId == 0 ? "fa-plus-circle" : "fa-pen-to-square";
}

<div class="container mt-5 mb-5">
    <div class="row justify-content-center">
        <div class="col-md-7">
            <div class="card card-zeta shadow-sm border-0">
                <div class="card-body p-5">

                    <div class="text-center mb-4">
                        <div class="rounded-circle bg-light d-inline-flex align-items-center justify-content-center mb-3" style="width: 60px; height: 60px;">
                            <i class="fa-solid @icon fa-2x" style="color: var(--zeta-cyan);"></i>
                        </div>
                        <h2 class="fw-bold text-zeta-dark">@title</h2>
                        <p class="text-muted small">Completa la información para organizar tus productos.</p>
                    </div>

                    @* IMPORTANTE: El enctype es obligatorio para subir fotos *@
                    <form asp-action="AddEdit" method="post" enctype="multipart/form-data">
                        <input type="hidden" asp-for="CategoryId" />
                        <input type="hidden" asp-for="IsActive" />
                        <input type="hidden" asp-for="ImageName" />

                        @* 1. NOMBRE *@
                        <div class="mb-4">
                            <label asp-for="Name" class="form-label fw-bold text-zeta-dark">Nombre de la Categoría</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0">
                                    <i class="fa-solid fa-tag text-muted"></i>
                                </span>
                                <input type="text" class="form-control border-start-0 ps-0"
                                       asp-for="Name" placeholder="Ej: Remeras, Tazas, Gorras..."
                                       autocomplete="off" />
                            </div>
                            <span asp-validation-for="Name" class="text-danger small fw-bold"></span>
                        </div>

                        @* 2. DESCRIPCIÓN (NUEVO) *@
                        <div class="mb-4">
                            <label asp-for="Description" class="form-label fw-bold text-zeta-dark">Descripción (Opcional)</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0 align-items-start pt-2">
                                    <i class="fa-solid fa-align-left text-muted"></i>
                                </span>
                                <textarea class="form-control border-start-0 ps-0"
                                          asp-for="Description" rows="3"
                                          placeholder="Ej: Las mejores prendas con diseños exclusivos..."></textarea>
                            </div>
                        </div>

                        @* 3. IMAGEN DE PORTADA (NUEVO) *@
                        <div class="mb-4">
                            <label asp-for="ImageFile" class="form-label fw-bold text-zeta-dark">Imagen de Portada (Opcional)</label>
                            <input asp-for="ImageFile" type="file" class="form-control" accept="image/*" />

                            @if (!string.IsNullOrEmpty(Model.ImageName))
                            {
                                <div class="mt-3 p-3 bg-light rounded-3 d-flex align-items-center gap-3 border">
                                    <img src="~/images/@Model.ImageName" alt="Portada Actual" class="rounded shadow-sm" style="width: 80px; height: 80px; object-fit: cover;" />
                                    <div>
                                        <p class="mb-0 fw-bold small text-muted text-uppercase">Imagen Actual</p>
                                        <p class="mb-0 small">@Model.ImageName</p>
                                    </div>
                                </div>
                            }
                        </div>

                        @* MENSAJE DE ÉXITO *@
                        @if (ViewBag.message != null)
                        {
                            <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm" role="alert" style="border-left: 5px solid #28a745 !important;">
                                <i class="fa-solid fa-check-circle me-2"></i> @ViewBag.message
                                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                            </div>
                        }

                        @* BOTONES *@
                        <div class="d-grid gap-2 mt-5">
                            <button class="btn btn-zeta-cyan py-2 shadow-sm" type="submit">
                                <i class="fa-solid fa-save me-2"></i> @btnAction
                            </button>
                            <a asp-action="Index" class="btn btn-outline-secondary py-2">
                                <i class="fa-solid fa-arrow-left me-2"></i> Volver al listado
                            </a>
                        </div>
                    </form>

                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}