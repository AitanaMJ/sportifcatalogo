@model List<CategoryVM>

<div class="container-fluid mt-4 mb-5">
    <div class="card card-zeta p-4 shadow-sm">

        <div class="row align-items-center mb-4">
            <div class="col-md-6">
                <h2 class="fw-bold m-0 text-zeta-dark">
                    <i class="fa-solid fa-tags me-2" style="color: var(--zeta-cyan);"></i>
                    Categorías
                </h2>
            </div>
            <div class="col-md-6 text-end">
                <a href="/Category/AddEdit" class="btn btn-zeta-orange shadow-sm px-4">
                    <i class="fa-solid fa-plus me-2"></i>Crear Categoría
                </a>
            </div>
        </div>

        @if (TempData["message"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show mb-4 border-0 shadow-sm" role="alert" style="border-left: 5px solid #28a745 !important;">
                <i class="fa-solid fa-check-circle me-2"></i> @TempData["message"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        <style>
            .dataTables_filter input {
                border-radius: 50px !important;
                border: 1px solid #ced4da !important;
                padding: 6px 20px !important;
                margin-left: 10px !important;
                transition: all 0.3s ease;
            }

                .dataTables_filter input:focus {
                    border-color: var(--zeta-cyan) !important;
                    box-shadow: 0 0 0 0.25rem rgba(23, 160, 156, 0.25) !important;
                    outline: none !important;
                }

            .dataTables_wrapper .page-item.active .page-link {
                background-color: var(--zeta-cyan) !important;
                border-color: var(--zeta-cyan) !important;
                border-radius: 50px !important;
            }

           
            .text-truncate-2 {
                display: -webkit-box;
                -webkit-line-clamp: 2;
                -webkit-box-orient: vertical;
                overflow: hidden;
            }
        </style>

        <div class="table-responsive">
            <table id="tablaCategorias" class="table table-zeta align-middle table-hover">
                <thead>
                    <tr>
                        <th style="width: 80px" class="text-center">Portada</th>
                        <th style="width: 25%">Nombre</th>
                        <th style="width: 40%">Descripción</th>
                        <th style="width: 15%">Estado</th>
                        <th class="text-end" style="width: 140px">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr style="@(!item.IsActive ? "opacity: 0.6; background-color: #f8f9fa;" : "")">

                            @* 1. COLUMNA PORTADA *@
                            <td class="text-center">
                                @if (!string.IsNullOrEmpty(item.ImageName))
                                {
                                    <img src="~/images/@item.ImageName" alt="@item.Name" class="rounded shadow-sm" style="width: 50px; height: 50px; object-fit: cover; border: 1px solid #eee;" />
                                }
                                else
                                {
                                    <div class="rounded bg-light d-flex align-items-center justify-content-center mx-auto" style="width: 50px; height: 50px; border: 1px solid #eee;">
                                        <i class="fa-regular fa-image text-muted" style="font-size: 1.2rem;"></i>
                                    </div>
                                }
                            </td>

                            @* 2. COLUMNA NOMBRE *@
                            <td class="fw-bold text-zeta-dark fs-6">
                                @item.Name
                            </td>

                            @* 3. COLUMNA DESCRIPCIÓN  *@
                            <td>
                                @if (!string.IsNullOrEmpty(item.Description))
                                {
                                    <span class="text-muted small text-truncate-2" title="@item.Description">
                                        @item.Description
                                    </span>
                                }
                                else
                                {
                                    <span class="text-muted small fst-italic">- Sin descripción -</span>
                                }
                            </td>

                            @* 4. COLUMNA ESTADO *@
                            <td>
                                @if (item.IsActive)
                                {
                                    <span class="badge rounded-pill bg-success px-3">Activo</span>
                                }
                                else
                                {
                                    <span class="badge rounded-pill bg-secondary px-3">Inactivo</span>
                                }
                            </td>

                            @* 5. COLUMNA ACCIONES  *@
                            <td class="text-end">
                                <a asp-controller="Category"
                                   asp-action="AddEdit"
                                   asp-route-id="@item.CategoryId"
                                   class="btn btn-sm btn-zeta-cyan text-white shadow-sm me-1"
                                   title="Editar">
                                    <i class="fa-solid fa-pen-to-square"></i>
                                </a>

                                <button type="button"
                                        class="btn btn-sm @(item.IsActive ? "btn-outline-danger" : "btn-outline-success") shadow-sm"
                                        onclick="confirmToggle(this, @item.CategoryId)"
                                        title="@(item.IsActive ? "Desactivar" : "Activar")">
                                    <i class="fa-solid @(item.IsActive ? "fa-eye-slash" : "fa-eye")"></i>
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css">

    <script>
        $(document).ready(function() {
            $('#tablaCategorias').DataTable({
                "stateSave": true,
                "language": {
                    "lengthMenu": "Mostrar _MENU_ categorías",
                    "zeroRecords": "No se encontraron categorías",
                    "info": "Mostrando _START_ a _END_ de _TOTAL_ categorías",
                    "infoEmpty": "No hay categorías disponibles",
                    "search": "Buscar:",
                    "paginate": {
                        "next": "Sig.",
                        "previous": "Ant."
                    }
                },
                "pageLength": 5,
               
                "ordering": false
            });
        });

        function confirmToggle(btn, id) {
            const url = '/Category/ToggleStatus?id=' + id;

            fetch(url, { method: 'POST' })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    location.reload();
                }
            })
            .catch(error => console.error('Error:', error));
        }
    </script>
}

