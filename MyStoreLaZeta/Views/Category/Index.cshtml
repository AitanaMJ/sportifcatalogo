@model List<CategoryVM>

<div class="row justify-content-between mt-4">
	<div class="col-4">
		<h4>Categorias</h4>
	</div>
	<div class="col-4 text-end">
		<a href="/Category/AddEdit" class="btn btn-success"><i class="fa-solid fa-plus"></i>Crear Categoria</a>
	</div>
</div>
<hr />

@if (TempData["message"] != null)
{
	<div class="alert alert-success alert-dismissible fade show mb-3" role="alert">
		@TempData["message"]
		<button type="button" class="btn-close" data-bs-dismiss="alert"></button>
	</div>
}


<table class="table table-striped">
	<thead>
		<tr>
			
			<th>Nombre</th>
			<th style="width:120px">Acciones</th>
		</tr>
	</thead>
	<tbody>
		@foreach(var item in Model)
		{
			<tr>
				<td>@item.Name</td>
				<td style="width:120px">
					<a asp-controller="Category"
					   asp-action="AddEdit"
					   asp-route-id="@item.CategoryId"
					   class="btn btn-sm btn-primary">
						<i class="fa-solid fa-pen-to-square"></i>
					</a>
					<button class="btn btn-sm btn-danger" onclick="deleteItem(@item.CategoryId)"><i class="fa-solid fa-trash"></i></button>
				</td>
			</tr>
		}


	</tbody>
</table>

@section Scripts{
	<script>
		function deleteItem(id){

	Swal.fire({
	  title: "Estas seguro?",
	/*  text: "You won't be able to revert this!",*/
	  icon: "warning",
	  showCancelButton: true,
	  confirmButtonColor: "#3085d6",
	  cancelButtonColor: "#d33",
	  confirmButtonText: "Si, Eliminar!",
      cancelButtonText: "No, Volver"
	  }).then((result) => {
	  	     if (result.isConfirmed) {
							  window.location.href = '@Url.Action("Delete", "Category")' + '?id=' + id;
			   
			   }
			  
	});
}
	</script>
}


