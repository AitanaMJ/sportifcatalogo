@model List<CategoryVM>

<div class="container-fluid mt-4 mb-5">
    <div class="card card-zeta p-4 shadow-sm border-0">

        <div class="row align-items-center mb-4">
            <div class="col-md-6">
                <h2 class="fw-bold m-0 text-zeta-dark">
                    <i class="fa-solid fa-tags me-2" style="color: var(--zeta-cyan);"></i>
                    Categorías
                </h2>
            </div>
            <div class="col-md-6 text-end">
                <a href="/Category/AddEdit" class="btn btn-zeta-orange shadow-sm px-4">
                    <i class="fa-solid fa-plus me-2"></i>Crear Categoría
                </a>
            </div>
        </div>

        @if (TempData["message"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show mb-4 border-0 shadow-sm" role="alert" style="border-left: 5px solid #28a745 !important;">
                <i class="fa-solid fa-check-circle me-2"></i> @TempData["message"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        <style>
            .filtro-zeta {
                border: 2px solid var(--zeta-cyan) !important;
                color: var(--zeta-cyan) !important;
                background-color: transparent !important;
                border-radius: 50px !important;
                font-weight: 600 !important;
                transition: all 0.3s ease;
            }

                .filtro-zeta:hover {
                    background-color: rgba(23, 160, 156, 0.1) !important;
                    color: var(--zeta-cyan) !important;
                }

                .filtro-zeta.active {
                    background-color: var(--zeta-cyan) !important;
                    color: white !important;
                    box-shadow: 0 4px 10px rgba(23, 160, 156, 0.4) !important;
                }

        </style>


        @* SECCIÓN DE FILTROS ACTUALIZADA *@
        <div class="d-flex flex-wrap gap-3 mb-4 bg-white p-3 rounded-4 shadow-sm border-0 align-items-center">
            <span class="fw-bold text-muted me-3" style="font-size: 0.95rem;">
                <i class="fa-solid fa-filter me-1"></i> Filtros:
            </span>

            <div class="d-flex gap-2">
                <input type="radio" class="btn-check" name="filtroEstado" id="filtroActivas" value="activo" checked>
                <label class="filtro-pill m-0" for="filtroActivas">
                    <i class="fa-solid fa-tags me-1"></i> Activas
                </label>

                <input type="radio" class="btn-check" name="filtroEstado" id="filtroInactivas" value="inactivo">
                <label class="filtro-pill m-0" for="filtroInactivas">
                    <i class="fa-solid fa-eye-slash me-1"></i> Inactivas
                </label>
            </div>
        </div>


        <style>


            .dataTables_filter input {
                border-radius: 50px !important;
                border: 1px solid #ced4da !important;
                padding: 6px 20px !important;
                margin-left: 10px !important;
                transition: all 0.3s ease;
            }

                .dataTables_filter input:focus {
                    border-color: var(--zeta-cyan) !important;
                    box-shadow: 0 0 0 0.25rem rgba(23, 160, 156, 0.25) !important;
                    outline: none !important;
                }

            .dataTables_wrapper {
                padding-bottom: 15px; /* Crea el espacio antes de la línea gris del card */
            }

            /* Esto hará que los números sean circulares como en Productos */
            .dataTables_wrapper .page-item .page-link {
                border-radius: 50% !important; /* Círculo perfecto */
                margin: 0 4px; /* Espaciado entre botones */
                width: 36px; /* Tamaño fijo para que sean círculos */
                height: 36px;
                display: flex;
                align-items: center;
                justify-content: center;
                color: var(--zeta-cyan);
                border: 1px solid #dee2e6;
            }

            /* Color para el botón de la página actual */
            .dataTables_wrapper .page-item.active .page-link {
                background-color: var(--zeta-cyan) !important;
                border-color: var(--zeta-cyan) !important;
                color: white !important;
            }

            /* Estilo para los botones Ant. y Sig. */
            .dataTables_wrapper .page-item:first-child .page-link,
            .dataTables_wrapper .page-item:last-child .page-link {
                border-radius: 50px !important; /* Ovalados para el texto */
                width: auto;
                padding: 0 15px;
            }

           
            .text-truncate-2 {
                display: -webkit-box;
                -webkit-line-clamp: 2;
                -webkit-box-orient: vertical;
                overflow: hidden;
            }

            .filtro-pill {
                border-radius: 50px !important;
                padding: 4px 16px;
                font-size: 0.9rem;
                font-weight: 600;
                color: var(--zeta-cyan);
                border: 1px solid var(--zeta-cyan);
                background-color: white;
                transition: all 0.2s ease-in-out;
                cursor: pointer;
            }

            /* Cuando el radio button oculto está seleccionado, pintamos el label */
            .btn-check:checked + .filtro-pill {
                background-color: var(--zeta-cyan) !important;
                color: white !important;
                border-color: var(--zeta-cyan) !important;
            }

            .filtro-pill:hover {
                background-color: #f0fdfc; /* Un fondo muy clarito al pasar el mouse */
            }

            /* Ajustes para móviles (Media Query) */
            @@media (max-width: 768px) {
                /* Hacemos que los botones de filtro ocupen el ancho necesario y no se peguen */
                .d-flex.align-items-center.mb-4 {
                    flex-direction: column;
                    align-items: flex-start !important;
                }

                .filtro-pill {
                    padding: 6px 12px;
                    font-size: 0.8rem;
                }
                /* Ajuste para que la tabla no rompa el diseño */
                .card-zeta {
                    padding: 1rem !important;
                }

                h2 {
                    font-size: 1.5rem;
                    margin-bottom: 15px !important;
                }
            }
           
        </style>

       
        <div class="table-responsive">
            <table id="tablaCategorias" class="table table-zeta align-middle table-hover">
                <thead>
                    <tr>
                        <th style="width: 80px" class="text-center">Portada</th>
                        <th style="width: 25%">Nombre</th>
                        <th style="width: 40%">Descripción</th>
                        <th style="width: 15%">Estado</th>
                        <th class="text-end" style="width: 140px">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr style="@(!item.IsActive ? "opacity: 0.6; background-color: #f8f9fa;" : "")">

                            @* 1. COLUMNA PORTADA *@
                            <td class="text-center">
                                @if (!string.IsNullOrEmpty(item.ImageName))
                                {
                                    <img src="~/images/@item.ImageName" alt="@item.Name" class="rounded shadow-sm" style="width: 50px; height: 50px; object-fit: cover; border: 1px solid #eee;" />
                                }
                                else
                                {
                                    <div class="rounded bg-light d-flex align-items-center justify-content-center mx-auto" style="width: 50px; height: 50px; border: 1px solid #eee;">
                                        <i class="fa-regular fa-image text-muted" style="font-size: 1.2rem;"></i>
                                    </div>
                                }
                            </td>

                            @* 2. COLUMNA NOMBRE *@
                            <td class="fw-bold text-zeta-dark fs-6">
                                @item.Name
                            </td>

                            @* 3. COLUMNA DESCRIPCIÓN  *@
                            <td>
                                @if (!string.IsNullOrEmpty(item.Description))
                                {
                                    <span class="text-muted small text-truncate-2" title="@item.Description">
                                        @item.Description
                                    </span>
                                }
                                else
                                {
                                    <span class="text-muted small fst-italic">- Sin descripción -</span>
                                }
                            </td>

                            @* 4. COLUMNA ESTADO *@
                            <td>
                                @if (item.IsActive)
                                {
                                    <span class="badge rounded-pill bg-success px-3">Activo</span>
                                }
                                else
                                {
                                    <span class="badge rounded-pill bg-secondary px-3">Inactivo</span>
                                }
                            </td>

                            @* 5. COLUMNA ACCIONES  *@
                            <td class="text-end">
                                <a asp-controller="Category"
                                   asp-action="AddEdit"
                                   asp-route-id="@item.CategoryId"
                                   class="btn btn-sm btn-zeta-cyan text-white shadow-sm me-1"
                                   title="Editar">
                                    <i class="fa-solid fa-pen-to-square"></i>
                                </a>

                                <button type="button"
                                        class="btn btn-sm @(item.IsActive ? "btn-outline-danger" : "btn-outline-success") shadow-sm"
                                        onclick="confirmToggle(this, @item.CategoryId)"
                                        title="@(item.IsActive ? "Desactivar" : "Activar")">
                                    <i class="fa-solid @(item.IsActive ? "fa-eye-slash" : "fa-eye")"></i>
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>
    <script src="https://cdn.datatables.net/responsive/2.5.0/js/dataTables.responsive.min.js"></script>
    <link rel="stylesheet" href="https://cdn.datatables.net/responsive/2.5.0/css/responsive.dataTables.min.css">
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css">

    <script>

               function confirmToggle(btn, id) {
            // 1. Referencia a la fila que queremos afectar
            const filaDOM = $(btn).closest('tr');
            const table = $('#tablaCategorias').DataTable();

            const url = '/Category/ToggleStatus?id=' + id;

            // Deshabilitamos el botón para que no clickeen mil veces
            btn.disabled = true;

            fetch(url, { method: 'POST' })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        // 2. CAMBIO AUTOMÁTICO SIN RECARGAR
                        // Buscamos la celda del "Estado" (columna 3)
                        const celdaEstado = table.cell(filaDOM, 3);

                        // Obtenemos el valor actual para saber qué poner ahora
                        const esActiva = celdaEstado.data().includes('bg-success');

                        if (esActiva) {
                            // Si era activa, ahora es inactiva (Badge gris)
                            celdaEstado.data('<span class="badge rounded-pill bg-secondary px-3">Inactivo</span>');
                            // Cambiamos el icono del ojito
                            $(btn).removeClass('btn-outline-danger').addClass('btn-outline-success')
                                  .html('<i class="fa-solid fa-eye"></i>');
                        } else {
                            // Si era inactiva, ahora es activa (Badge verde)
                            celdaEstado.data('<span class="badge rounded-pill bg-success px-3">Activo</span>');
                            // Cambiamos el icono del ojito
                            $(btn).removeClass('btn-outline-success').addClass('btn-outline-danger')
                                  .html('<i class="fa-solid fa-eye-slash"></i>');
                        }

                        // 3. RE-FILTRAR
                        // Al ejecutar draw(), como la categoría cambió de estado,
                        // el filtro la ocultará automáticamente de la vista actual.
                        table.draw(false); // el false es para que no se mueva de la página actual de la tabla
                    } else {
                        alert("Error: " + data.message);
                    }
                })
                .catch(error => {
                    console.error('Error:', error);
                })
                .finally(() => {
                    btn.disabled = false;
                });
        }
              $(document).ready(function() {
            // 1. Inicializamos la tabla
            var table = $('#tablaCategorias').DataTable({
                "responsive": true,
                "stateSave": false, // Desactívalo un momento para probar si es esto
                "language": {
                    "lengthMenu": "Mostrar _MENU_ categorías",
                    "zeroRecords": "No se encontraron categorías",
                    "info": "Mostrando _START_ a _END_ de _TOTAL_ categorías",
                    "infoEmpty": "No hay categorías disponibles",
                    "infoFiltered": "(filtered from _MAX_ total entries)",
                    "search": "Buscar:",
                    "paginate": { "next": "Sig.", "previous": "Ant." }
                },
                "pageLength": 5,
                "ordering": false
            });

            // 2. Nueva regla de filtro más simple y directa
            $.fn.dataTable.ext.search.push(
                function(settings, data, dataIndex) {
                    // data[3] es el texto puro que DataTables ve en la columna Estado
                    var textoColumna = data[3].toLowerCase();
                    var filtroSeleccionado = $('input[name="filtroEstado"]:checked').val().toLowerCase();

                    // Verificamos si la palabra "activo" o "inactivo" está presente en la celda
                    if (filtroSeleccionado === 'activo') {
                        return textoColumna.includes('activo') && !textoColumna.includes('inactivo');
                    } else if (filtroSeleccionado === 'inactivo') {
                        return textoColumna.includes('inactivo');
                    }
                    return true;
                }
            );

            // 3. Evento de cambio
            $('input[name="filtroEstado"]').on('change', function() {
                table.draw();
            });

            // Dibujamos al cargar
            table.draw();
        });
    </script>
}

