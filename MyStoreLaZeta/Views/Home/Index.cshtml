@model CatalogVM;
@{
    ViewData["Title"] = "Catálogo de Merchandising";
}

<div class="container mt-4 mb-5">
    <div class="row align-items-center p-4 p-lg-5 rounded-4 shadow-sm"
         style="background-color: #f8fbfb; border: 2px solid #eef7f7;">

        <div class="col-lg-6 order-2 order-lg-1 text-center text-lg-start">
            <h6 class="fw-bold text-uppercase mb-3" style="color: var(--zeta-cyan); letter-spacing: 2px;">
                LA ZETA MERCHANDISING
            </h6>

            <h1 class="display-5 fw-bold text-zeta-dark mb-4 lh-sm">
                Los mejores productos personalizados en un solo lugar.
            </h1>

            <div class="d-flex align-items-center justify-content-center justify-content-lg-start mb-4 p-3 rounded-3 bg-white shadow-sm border d-inline-flex">
                <div class="rounded-circle d-flex align-items-center justify-content-center me-3"
                     style="width: 45px; height: 45px; background-color: #fff3eb;">
                    <i class="fa-solid fa-truck-fast fa-lg" style="color: var(--zeta-orange);"></i>
                </div>
                <div>
                    <h5 class="fw-bold mb-0 text-zeta-dark">Envíos a todo Tucumán.</h5>
                    <small class="text-muted">Recibí tu pedido rápido y seguro.</small>
                </div>
            </div>

            <div class="mt-3">
                <a href="#catalogo-productos" class="btn btn-zeta-orange btn-lg px-5 shadow fw-bold text-uppercase">
                    Ver Catálogo <i class="fa-solid fa-arrow-down ms-2"></i>
                </a>
            </div>
        </div>

        <div class="col-lg-6 order-1 order-lg-2 mb-5 mb-lg-0">
            <div class="position-relative">
                <div class="position-absolute top-0 start-0 w-100 h-100 bg-white rounded-4 shadow-lg"
                     style="transform: rotate(-3deg); z-index: 0; opacity: 0.5;"></div>

                <img src="~/images/hero_merch.png"
                     alt="Productos La Zeta"
                     class="img-fluid rounded-4 shadow position-relative"
                     style="z-index: 1; border: 5px solid white;"
                     onerror="this.src='https://placehold.co/600x400/eef7f7/17A09C?text=Tu+Imagen+Aquí'; this.style.border='none';">
            </div>
        </div>
    </div>
</div>

<div class="container mb-5" id="catalogo-productos">
    <div class="row g-3 justify-content-center align-items-center">

        <div class="col-12 col-md-auto">
            <button type="button"
                    class="btn btn-zeta-cyan btn-mobile-full py-2 fw-bold rounded-pill shadow-sm"
                    data-bs-toggle="modal"
                    data-bs-target="#exampleModal">
                <i class="fa-solid fa-layer-group me-2"></i>Categorías
            </button>
        </div>

        <div class="col-12 col-md-8 col-lg-7">
            <form action="/Home/FilterBySearch" method="post" class="m-0">
                <div class="input-group shadow-sm rounded-pill overflow-hidden border bg-white">
                    <span class="input-group-text bg-white border-0 ps-4">
                        <i class="fas fa-search text-muted"></i>
                    </span>
                    <input type="text" class="form-control border-0 py-2 shadow-none"
                           name="value" autocomplete="off"
                           placeholder="Buscar tazas, remeras, gorras..." />
                    <button class="btn btn-zeta-orange px-4 fw-bold" type="submit">
                        BUSCAR
                    </button>
                </div>
            </form>
        </div>

    </div>
</div>


@if (!string.IsNullOrEmpty(Model.filterBy))
{
    <div class="container mb-4">
        <div class="d-inline-flex align-items-center bg-light border p-2 px-3 rounded-pill shadow-sm">
            <i class="fa-solid fa-filter me-2 text-muted small"></i>
            <span class="text-dark small">Viendo: <strong style="color: var(--zeta-cyan);">@Model.filterBy</strong></span>
            <a asp-action="Index" class="ms-3 text-danger text-decoration-none">
                <i class="fa-solid fa-circle-xmark"></i>
            </a>
        </div>
    </div>
}

<div class="container">
    <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4 py-4">
        @foreach (var p in Model.Products)
        {
            <div class="col">
                <div class="card h-100 card-zeta border-0 shadow-sm overflow-hidden">
                    <div class="position-relative" style="height: 220px; background-color: #fcfcfc;">
                        <img class="w-100 h-100" src="~/images/@p.ImageName"
                             style="object-fit: contain; padding: 10px;" alt="@p.Name" />
                    </div>

                    <div class="card-body p-4 text-center d-flex flex-column">
                        <h6 class="text-uppercase text-muted x-small fw-bold mb-2" style="font-size: 0.7rem;">
                            @(p.Category?.Name ?? "Sin Categoría")
                        </h6>

                        <h5 class="fw-bold text-zeta-dark flex-grow-1">@p.Name</h5>

                        <div class="mt-3">
                            <h4 class="fw-bold mb-3" style="color: var(--zeta-cyan);">@p.Price.ToString("C2")</h4>
                            <div class="d-grid">
                                <a class="btn btn-zeta-orange mt-auto fw-bold" href="/Home/ProductDetail?id=@p.ProductId">
                                    Ver Detalles
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<div class="modal fade" id="exampleModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4">
            <div class="modal-header border-0 pb-0">
                <h2 class="modal-title fw-bold fs-4 ms-3" style="color: var(--zeta-dark);">Categorías</h2>
                <button type="button" class="btn-close me-2" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <div class="row g-3">
                    <div class="col-6">
                        <a class="btn btn-outline-dark w-100 py-3 rounded-3 fw-bold @(Model.filterBy == "Todas" ? "active" : "")"
                           asp-controller="Home" asp-action="FilterByCategory" asp-route-Id="0" asp-route-name="Todas">
                            <i class="fa-solid fa-border-all d-block mb-1"></i> Todas
                        </a>
                    </div>
                    @foreach (var category in Model.Categories)
                    {
                        <div class="col-6">
                            <a class="btn btn-outline-secondary w-100 py-3 rounded-3 fw-bold @(Model.filterBy == category.Name ? "active" : "")"
                               style="border-color: #eee;"
                               asp-controller="Home" asp-action="FilterByCategory"
                               asp-route-Id="@category.CategoryId" asp-route-name="@category.Name">
                                <i class="fa-solid fa-tag d-block mb-1 opacity-50"></i> @category.Name
                            </a>
                        </div>
                    }
                </div>
            </div>
            <div class="modal-footer border-0 pt-0">
                <button type="button" class="btn btn-light text-muted w-100 rounded-3" data-bs-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>
