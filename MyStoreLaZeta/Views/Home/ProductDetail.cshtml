@model ProductVM

<section class="py-5">
    <div class="container px-4 px-lg-5 my-5">
        <div class="row gx-4 gx-lg-5 align-items-center">

            <div class="col-md-6 mb-5 mb-md-0">
                <div class="card card-zeta border-0 shadow-sm overflow-hidden p-3 bg-white">
                    <img class="img-fluid rounded shadow-sm"
                         src="~/images/@Model.ImageName"
                         alt="@Model.Name"
                         style="max-height: 550px; object-fit: contain; width: 100%;"
                         loading="lazy" />
                </div>
            </div>

            <div class="col-md-6 ps-lg-5">
                <span class="badge mb-2 px-3 py-2 text-uppercase" style="background-color: var(--zeta-dark); font-size: 0.7rem; letter-spacing: 1px;">
                    @Model.Category.Name
                </span>

                <h1 class="display-4 fw-bold text-zeta-dark mb-3">@Model.Name</h1>

                <div class="mb-3">
    @if (Model.Discount > 0)
    {
        <span class="text-muted text-decoration-line-through fs-5">@Model.Price.ToString("C")</span>
        <span class="badge bg-danger ms-2">@Model.Discount% OFF</span>
        <h2 class="text-danger fw-bold">
            @((Model.Price - (Model.Price * Model.Discount.Value / 100)).ToString("C"))
        </h2>
    }
    else
    {
        <h2 class="text-zeta-cyan fw-bold">@Model.Price.ToString("C")</h2>
    }
</div>

                <div class="description-box mb-4 text-muted lh-lg">
                    @Html.Raw(Model.Description)
                </div>

                <div class="bg-light p-3 rounded-3 mb-4 border-start border-4 border-info">
                    <div class="d-flex align-items-center mb-2">
                        <i class="fa-solid fa-truck-fast me-2 text-info"></i>
                        <span class="small fw-bold">Envíos a todo Tucumán y el país.</span>
                    </div>
                    <div class="d-flex align-items-center">
                        <i class="fa-solid fa-store me-2 text-info"></i>
                        <span class="small fw-bold">Retiro gratis en San Miguel de Tucumán.</span>
                    </div>
                </div>

                <form action="/Home/AddItemToCart" method="post" id="cartForm">
                    <input hidden name="productId" asp-for="@Model.ProductId" />

                    @if (Model.HasVariations && Model.Variations.Any())
                    {
                        <div class="product-selection-area mb-4 p-3 bg-light rounded-3">
                            <h6 class="fw-bold text-uppercase mb-2" style="font-size: 0.75rem; color: #666;">1. Elegí Color:</h6>
                            <div class="d-flex gap-2 mb-3" id="color-options">
                                @foreach (var color in Model.Variations.Select(v => v.Color.Trim().ToUpper()).Distinct())
                                {
                                    <button type="button" class="btn btn-outline-dark rounded-pill px-3 btn-color-selector" data-color="@color">
                                        @color
                                    </button>
                                }
                            </div>

                            <h6 class="fw-bold text-uppercase mb-2" style="font-size: 0.75rem; color: #666;">2. Elegí Talle:</h6>
                            <div class="d-flex gap-2" id="size-options">
                                <p class="text-muted small italic m-0">Seleccioná un color primero...</p>
                            </div>

                            <div id="error-message" class="text-danger small fw-bold mt-2" style="display: none;">
                                <i class="fa-solid fa-circle-exclamation me-1"></i> Por favor, elegí color y talle.
                            </div>

                            <input type="hidden" id="selectedVariationId" name="variationId" value="" />
                        </div>
                    }

                    <div class="d-flex align-items-center gap-3">
                        <div class="quantity-input shadow-sm rounded-3 overflow-hidden d-flex border">
                            <input class="form-control text-center border-0 fw-bold"
                                   name="quantity" type="number" value="1" min="1"
                                   style="width: 70px; height: 50px;" />
                        </div>

                        <button id="btnAddToCart" class="btn btn-zeta-orange flex-grow-1 py-3 fw-bold text-uppercase shadow-sm" type="submit">
                            <i class="fa-solid fa-cart-shopping me-2"></i>
                            Añadir al carrito
                        </button>
                    </div>
                </form>

                <div class="mt-4">
                    <a class="btn btn-link text-muted text-decoration-none px-0" href="/Home/Catalogo">
                        <i class="fa-solid fa-arrow-left me-1"></i> Volver al catálogo
                    </a>
                </div>

                @if (ViewBag.message != null)
                {
                    <div class="alert alert-success mt-4 border-0 shadow-sm d-flex align-items-center" role="alert" style="border-left: 5px solid #28a745 !important;">
                        <i class="fa-solid fa-circle-check fa-lg me-3"></i>
                        <div>@ViewBag.message</div>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@section Scripts {
    @if (Model.HasVariations && Model.Variations != null && Model.Variations.Any())
    {
        <script>
            // 1. Cargamos las variaciones
            const variations = @Html.Raw(Json.Serialize(Model.Variations.Select(v => new { 
                id = v.Id, 
                color = v.Color.Trim().ToUpper(), 
                size = v.Size.Trim().ToUpper(), 
                stock = v.Stock 
            }).ToList()));

            // 2. EVENTO DE COLOR
            document.querySelectorAll('.btn-color-selector').forEach(button => {
                button.addEventListener('click', function() {
                    document.querySelectorAll('.btn-color-selector').forEach(b => b.classList.remove('active', 'btn-dark'));
                    this.classList.add('active', 'btn-dark');

                    const selectedColor = this.getAttribute('data-color');
                    renderSizes(selectedColor);
                });
            });

            // 3. FUNCIÓN DE TALLES
            function renderSizes(color) {
                const sizeContainer = document.getElementById('size-options');
                sizeContainer.innerHTML = '';

                const filtered = variations.filter(v => v.color === color);

                filtered.forEach(v => {
                    const btn = document.createElement('button');
                    btn.type = 'button';
                    btn.className = 'btn btn-outline-secondary rounded-pill px-3 btn-size-selector';
                    btn.innerText = v.size;

                    if (v.stock <= 0) {
                        btn.disabled = true;
                        btn.classList.add('opacity-50', 'text-decoration-line-through');
                    }

                    btn.onclick = () => {
                        document.querySelectorAll('.btn-size-selector').forEach(b => b.classList.remove('active', 'btn-dark'));
                        btn.classList.add('active', 'btn-dark');
                        
                        // Guardamos el ID
                        document.getElementById('selectedVariationId').value = v.id;
                        
                        // Si elige talle, ocultamos el error si estaba visible
                        document.getElementById('error-message').style.display = 'none';
                    };
                    sizeContainer.appendChild(btn);
                });
            }

            // 4. VALIDACIÓN SIMPLE (Texto en rojo)
            document.getElementById('cartForm').onsubmit = function(e) {
                const hasVar = "@Model.HasVariations".toLowerCase() === "true";
                const selected = document.getElementById('selectedVariationId').value;
                const errorDiv = document.getElementById('error-message');

                if (hasVar && !selected) {
                    e.preventDefault(); // No enviamos el formulario
                    errorDiv.style.display = 'block'; // Mostramos el mensaje rojo
                }
            };
        </script>
    }
}