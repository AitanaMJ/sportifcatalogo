@model CatalogoPro.Models.ProductVM
@{
    ViewData["Title"] = Model.Name;

    // Configurá acá el número de WhatsApp de La Zeta (con código de país y área, sin el + ni espacios)
    // Ejemplo para Tucumán: 549381XXXXXXX
    string whatsappNumber = "543813577459";
}

<div class="container mt-5">
    <div class="row bg-white p-4 rounded shadow-sm">

        <!-- Columna de la Imagen -->
        <div class="col-md-6 mb-4 text-center">
            @if (!string.IsNullOrEmpty(Model.ImageName))
            {
                <img src="~/images/@Model.ImageName" class="img-fluid rounded" alt="@Model.Name" style="max-height: 500px; object-fit: contain;" />
            }
            else
            {
                <img src="~/images/no-image.png" class="img-fluid rounded" alt="Sin imagen" />
            }
        </div>

        <!-- Columna de Detalles -->
        <div class="col-md-6 d-flex flex-column justify-content-center">
            <h1 class="fw-bold mb-2">@Model.Name</h1>

            <h2 class="text-success fw-bold mb-4">
                $@Model.Price.ToString("N2")
            </h2>

            <p class="text-muted mb-4" style="font-size: 1.1rem;">
                @Model.Description
            </p>

            <!-- Selector de Variaciones (Solo se muestra si HasVariations es true) -->
            @if (Model.HasVariations && Model.Variations != null && Model.Variations.Any())
            {
                <div class="mb-4 p-3 border rounded bg-light">
                    <label for="variationSelect" class="form-label fw-bold">Elegí tu opción:</label>
                    <select id="variationSelect" class="form-select form-select-lg border-secondary">
                        <option value="">Seleccioná un talle o color...</option>
                        @foreach (var variation in Model.Variations)
                        {
                            <option value="Color: @variation.Color - Talle: @variation.Size">
                                @variation.Color | @variation.Size
                            </option>
                        }
                    </select>
                    <!-- Mensaje de error oculto por defecto -->
                    <div id="variationError" class="text-danger mt-2 d-none fw-semibold">
                        <i class="fa-solid fa-circle-exclamation"></i> Por favor, seleccioná una opción antes de consultar.
                    </div>
                </div>
            }

            <!-- Botón de WhatsApp -->
            <button id="btnWhatsApp" class="btn btn-success btn-lg w-100 rounded-pill fw-bold shadow-sm py-3 mt-auto">
                <i class="fa-brands fa-whatsapp fa-xl me-2"></i> Consultar por WhatsApp
            </button>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('btnWhatsApp').addEventListener('click', function () {
            // Variables enviadas desde Razor al script
            const productName = '@Html.Raw(Model.Name)';
            const hasVariations = '@Model.HasVariations'.toLowerCase() === 'true';
            let variationText = '';

            // Validación de variaciones
            if (hasVariations) {
                const select = document.getElementById('variationSelect');

                // Si el producto tiene variaciones pero no eligió ninguna, frenamos la ejecución
                if (select.value === '') {
                    document.getElementById('variationError').classList.remove('d-none');
                    return;
                }

                // Si eligió una, ocultamos el error y guardamos el texto
                document.getElementById('variationError').classList.add('d-none');
                variationText = ` (${select.value})`;
            }

            // Armado del mensaje dinámico
            const message = `Hola, me interesa el producto: *${productName}*${variationText}. ¿Me podrían dar más información?`;

            // Construcción de la URL de WhatsApp
            const whatsappUrl = `https://wa.me/@whatsappNumber?text=${encodeURIComponent(message)}`;

            // Redirección en una nueva pestaña
            window.open(whatsappUrl, '_blank');
        });
    </script>
}