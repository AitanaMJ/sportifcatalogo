@model ProductVM

<section class="py-5">
    <div class="container px-4 px-lg-5 my-5">
        <div class="row gx-4 gx-lg-5 align-items-center">

            <div class="col-md-6 mb-5 mb-md-0">
                <div class="card card-zeta border-0 shadow-sm overflow-hidden p-3 bg-white">
                    <img class="img-fluid rounded shadow-sm"
                         src="~/images/@Model.ImageName"
                         alt="@Model.Name"
                         style="max-height: 550px; object-fit: contain; width: 100%;"
                         loading="lazy" />
                </div>
            </div>

            <div class="col-md-6 ps-lg-5">
                <span class="badge mb-2 px-3 py-2 text-uppercase" style="background-color: var(--zeta-dark); font-size: 0.7rem; letter-spacing: 1px;">
                    @Model.Category.Name
                </span>

                <h1 class="display-4 fw-bold text-zeta-dark mb-3">@Model.Name</h1>

                <div class="fs-3 mb-4 fw-bold" style="color: var(--zeta-cyan);">
                    @Model.Price.ToString("C2")
                </div>

                <div class="description-box mb-4 text-muted lh-lg">
                    @Html.Raw(Model.Description)
                </div>

                <div class="bg-light p-3 rounded-3 mb-4 border-start border-4 border-info">
                    <div class="d-flex align-items-center mb-2">
                        <i class="fa-solid fa-truck-fast me-2 text-info"></i>
                        <span class="small fw-bold">Envíos a todo Tucumán y el país.</span>
                    </div>
                    <div class="d-flex align-items-center">
                        <i class="fa-solid fa-store me-2 text-info"></i>
                        <span class="small fw-bold">Retiro gratis en San Miguel de Tucumán.</span>
                    </div>
                </div>

                <form action="/Home/AddItemToCart" method="post">
                    <div class="d-flex align-items-center gap-3">
                        <input hidden name="productId" asp-for="@Model.ProductId" />

                        <div class="quantity-input shadow-sm rounded-3 overflow-hidden d-flex border">
                            <input class="form-control text-center border-0 fw-bold"
                                   name="quantity" type="number" value="1" min="1"
                                   style="width: 70px; height: 50px;" />
                        </div>

                        <button class="btn btn-zeta-orange flex-grow-1 py-3 fw-bold text-uppercase shadow-sm" type="submit">
                            <i class="fa-solid fa-cart-shopping me-2"></i>
                            Añadir al carrito
                        </button>
                    </div>
                </form>

                <div class="mt-4">
                    <a class="btn btn-link text-muted text-decoration-none px-0" href="/Home/Index">
                        <i class="fa-solid fa-arrow-left me-1"></i> Volver al catálogo
                    </a>
                </div>

                @if (ViewBag.message != null)
                {
                    <div class="alert alert-success mt-4 border-0 shadow-sm d-flex align-items-center" role="alert" style="border-left: 5px solid #28a745 !important;">
                        <i class="fa-solid fa-circle-check fa-lg me-3"></i>
                        <div>@ViewBag.message</div>
                    </div>
                }
            </div>
        </div>
    </div>
</section>