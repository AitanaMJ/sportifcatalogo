@model List<CartItemVM>

<div class="container mt-5">
    @if (Model.Count() != 0)
    {
        <div class="row align-items-center mb-4">
            <div class="col-md-6">
                <h2 class="fw-bold m-0 text-zeta-dark">
                    <i class="fa-solid fa-cart-shopping me-2" style="color: var(--zeta-cyan);"></i>
                    Tu Carrito
                </h2>
            </div>
            <div class="col-md-6 text-end">
                <a asp-controller="Home" asp-action="Checkout" class="btn btn-zeta-orange px-4 py-2 shadow-sm fw-bold">
                    INICIAR COMPRA <i class="fa-solid fa-arrow-right ms-2"></i>
                </a>
            </div>
        </div>

        <div class="card card-zeta border-0 shadow-sm p-3">
            <div class="table-responsive">
                <table class="table table-zeta align-middle">
                    <thead class="text-muted small text-uppercase">
                        <tr>
                            <th style="width: 100px">Producto</th>
                            <th>Descripción</th>
                            <th class="text-center">Precio</th>
                            <th class="text-center">Cantidad</th>
                            <th class="text-center">Subtotal</th>
                            <th class="text-end"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    <div class="bg-light rounded p-1 shadow-sm" style="width: 80px; height: 80px;">
                                        <img class="w-100 h-100 rounded" src="~/images/@item.ImageName" 
                                             alt="@item.Name" style="object-fit: contain;" loading="lazy" />
                                    </div>
                                </td>
                                <td>
                                    <h6 class="fw-bold mb-0 text-zeta-dark">@item.Name</h6>
                                    <small class="text-muted">ID: #@item.ProductId</small>
                                </td>
                                <td class="text-center">@item.Price.ToString("C2")</td>
                                <td class="text-center">
                                    <span class="badge bg-light text-dark border px-3 py-2">@item.Quantity</span>
                                </td>
                                <td class="text-center fw-bold" style="color: var(--zeta-cyan);">
                                    @((item.Price * item.Quantity).ToString("C2"))
                                </td>
                                <td class="text-end">
                                    <a href="/Home/RemoveItemToCart?productId=@item.ProductId" 
                                       class="btn btn-sm btn-outline-danger border-0" title="Quitar">
                                        <i class="fa-solid fa-trash-can"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="row justify-content-end mt-4">
                <div class="col-md-4 text-end">
                    <div class="p-3 rounded-3 bg-light">
                        <span class="text-muted">Total estimado:</span>
                        <h3 class="fw-bold m-0" style="color: var(--zeta-dark);">
                            @Model.Sum(x => x.Price * x.Quantity).ToString("C2")
                        </h3>
                    </div>
                </div>
            </div>
        </div>

        <div class="mt-4">
            <a asp-action="Index" class="btn btn-link text-muted text-decoration-none">
                <i class="fa-solid fa-chevron-left me-1"></i> Seguir comprando
            </a>
        </div>
    }
    else
    {
        <div class="text-center py-5">
            <div class="mb-4">
                <i class="fa-solid fa-cart-arrow-down fa-5x opacity-25"></i>
            </div>
            <h2 class="fw-bold">Tu carrito está vacío</h2>
            <p class="text-muted">¡Aprovecha nuestras ofertas y llévate lo mejor de La Zeta!</p>
            <a asp-action="Index" class="btn btn-zeta-cyan px-5 py-3 mt-3 shadow-sm">
                VER CATÁLOGO DE PRODUCTOS
            </a>
        </div>
    }
</div>