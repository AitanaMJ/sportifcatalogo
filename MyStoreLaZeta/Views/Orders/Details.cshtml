@model MyStoreLaZeta.Entities.Order

<div class="container mt-4 mb-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold text-zeta-dark">
            <i class="fa-solid fa-receipt text-zeta-cyan me-2"></i>Pedido #@Model.OrderId
        </h2>
        @* Botón dinámico según el rol *@
        <a asp-action="@(User.IsInRole("Admin") ? "ManageOrders" : "MyOrders")" class="btn btn-outline-secondary shadow-sm">
            <i class="fa-solid fa-arrow-left me-1"></i> Volver a @(User.IsInRole("Admin") ? "la gestión" : "mis compras")
        </a>
    </div>

    <div class="row">
        <div class="col-md-8">
            <div class="card card-zeta mb-4 shadow-sm border-0">
                <div class="card-header bg-white fw-bold py-3">
                    <i class="fa-solid fa-box-open me-2 text-muted"></i>Productos del Pedido
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover mb-0 align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th class="ps-4">Producto</th>
                                    <th class="text-center">Cant.</th>
                                    <th class="text-end">Precio Unit.</th>
                                    <th class="text-end pe-4">Subtotal</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.OrderItems)
                                {
                                    <tr>
                                        <td class="ps-4">@item.ProductName</td>
                                        <td class="text-center">@item.Quantity</td>
                                        <td class="text-end">$@item.Price.ToString("N2")</td>
                                        <td class="text-end pe-4 fw-bold text-zeta-dark">
                                            $@((item.Price * item.Quantity).ToString("N2"))
                                        </td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot>
                                <tr class="bg-light">
                                    <td colspan="3" class="text-end fw-bold text-muted text-uppercase py-3">Total Pagado:</td>
                                    <td class="text-end pe-4 fs-4 fw-bold text-zeta-cyan py-3">$@Model.TotalAmount.ToString("N2")</td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            @* PANEL DE ADMIN: Solo se muestra si es administrador *@
            @if (User.IsInRole("Admin"))
            {
                <div class="card border-0 mb-4 shadow-sm" style="border-top: 4px solid #ffc107 !important;">
                    <div class="card-header bg-white text-dark fw-bold">
                        <i class="fa-solid fa-user-shield me-2 text-warning"></i>Gestión de Estado
                    </div>
                    <div class="card-body bg-light">
                        <p class="small text-muted mb-2">Estado actual:</p>
                        <div class="mb-3">
                            @* Badge con color dinámico *@
                            @{
                                var badgeColor = Model.Status == "Pendiente" ? "bg-warning text-dark" : "bg-success";
                            }
                            <span class="badge @badgeColor px-3 py-2 fs-6">@Model.Status</span>
                        </div>

                        <form asp-action="UpdateStatus" method="post">
                            <input type="hidden" name="id" value="@Model.OrderId" />
                            <label class="form-label small fw-bold">Actualizar a:</label>
                            <div class="d-grid gap-2">
                                <select name="status" class="form-select mb-2">
                                    <option value="Pendiente" selected="@(Model.Status == "Pendiente")">Pendiente</option>
                                    <option value="En Preparación" selected="@(Model.Status == "En Preparación")">En Preparación</option>
                                    <option value="Enviado" selected="@(Model.Status == "Enviado")">Enviado</option>
                                    <option value="Entregado" selected="@(Model.Status == "Entregado")">Entregado</option>
                                    <option value="Cancelado" selected="@(Model.Status == "Cancelado")">Cancelado</option>
                                </select>
                                <button type="submit" class="btn btn-dark fw-bold shadow-sm">
                                    <i class="fa-solid fa-floppy-disk me-1"></i> Guardar Cambios
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            }

            @* INFORMACIÓN DEL PEDIDO (Visible para todos) *@
            <div class="card card-zeta border-0 shadow-sm">
                <div class="card-body">
                    <h5 class="card-title text-zeta-cyan fw-bold mb-4">
                        <i class="fa-solid fa-circle-info me-2"></i>Información del Pedido
                    </h5>

                    <div class="mb-3">
                        <label class="text-muted small d-block">Cliente</label>
                        <span class="fw-bold">@Model.ClientName</span>
                        <div class="small text-muted"><i class="fa-solid fa-envelope me-1"></i> @Model.Email</div>
                    </div>

                    <div class="mb-3">
                        <label class="text-muted small d-block">Entrega</label>
                        <span class="fw-bold"><i class="fa-solid fa-truck-fast me-1 text-zeta-cyan"></i> @Model.ShippingMethod</span>
                        <div class="alert alert-secondary mt-2 py-2 px-3 small border-0 bg-light">
                            <i class="fa-solid fa-location-dot me-1 text-muted"></i> @Model.Address
                        </div>
                    </div>

                    <div class="mb-0">
                        <label class="text-muted small d-block">Método de Pago</label>
                        <span class="badge bg-white text-dark border px-3">
                            <i class="fa-solid fa-credit-card me-1 text-muted"></i> @Model.PaymentMethod
                        </span>
                    </div>

                   
                </div>
            </div>
        </div>
    </div>
</div>