@model IEnumerable<MyStoreLaZeta.Entities.Order>

<div class="container mt-4">
    <h2 class="text-zeta-dark mb-4">Administración de Pedidos</h2>

    <div class="card card-zeta p-3">


        <link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css">
        <style>
            /* Caja de Búsqueda redondeada */
            .dataTables_filter input {
                border-radius: 50px !important;
                border: 1px solid #ced4da !important;
                padding: 6px 20px !important;
                margin-left: 10px !important;
                transition: all 0.3s ease;
            }

                .dataTables_filter input:focus {
                    border-color: var(--zeta-cyan) !important;
                    box-shadow: 0 0 0 0.25rem rgba(23, 160, 156, 0.25) !important;
                    outline: none !important;
                }

            /* Selector de cantidad */
            .dataTables_length select {
                border-radius: 10px !important;
                padding: 4px 30px 4px 10px !important;
                border: 1px solid #ced4da !important;
            }

            /* Diseño de la Paginación */
            .dataTables_wrapper .pagination {
                margin-top: 20px !important;
            }

            .dataTables_wrapper .page-item.active .page-link {
                background-color: var(--zeta-cyan) !important;
                border-color: var(--zeta-cyan) !important;
                color: white !important;
                border-radius: 50px !important;
                box-shadow: 0 4px 10px rgba(23, 160, 156, 0.3) !important;
            }

            .dataTables_wrapper .page-item .page-link {
                border: none !important;
                color: #555;
                font-weight: 600;
                border-radius: 50px !important;
                margin: 0 3px;
                padding: 8px 16px;
                background-color: transparent;
            }

            .dataTables_wrapper .page-item:not(.active) .page-link:hover {
                background-color: #f8f9fa !important;
                color: var(--zeta-cyan) !important;
            }
        </style>



        <div class="table-responsive">
            <table id="tablaPedidos" class="table table-striped align-middle">
            <thead class="bg-light">
                <tr>
                    <th>#ID</th>
                    <th>Cliente</th>
                    <th>Fecha</th>
                    <th>Total</th>
                    <th>Envío</th>
                    <th>Estado</th>
                    <th></th>
                </tr>
            </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.OrderId</td>

                            <td>
                                <div class="fw-bold">@item.ClientName</div>
                                <small class="text-muted">@item.Email</small>
                            </td>

                            <td>@item.OrderDate.ToString("dd/MM/yy")</td>

                            <td class="text-success fw-bold">$@item.TotalAmount.ToString("N0")</td>

                            <td>@item.ShippingMethod</td>

                            <td>
                                @if (item.Status == "Pendiente")
                                {
                                    <span class="badge bg-warning text-dark">Pendiente</span>
                                }
                                else if (item.Status == "Cancelado")
                                {
                                    <span class="badge bg-danger">Cancelado</span>
                                }
                                else if (item.Status == "Entregado")
                                {
                                    <span class="badge bg-success">Entregado</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">@item.Status</span>
                                }
                            </td>

                            <td>
                                <a asp-action="Details" asp-route-id="@item.OrderId" class="btn btn-sm btn-primary">
                                    <i class="fa-solid fa-eye"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
        </table>
            </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>

    <script>
        $(document).ready(function() {
            $('#tablaPedidos').DataTable({
                "language": {
                    "lengthMenu": "Mostrar _MENU_ pedidos",
                    "zeroRecords": "No se encontraron pedidos",
                    "info": "Mostrando _START_ a _END_ de _TOTAL_ pedidos",
                    "infoEmpty": "No hay pedidos disponibles",
                    "infoFiltered": "(filtrado de _MAX_ totales)",
                    "search": "Buscar:",
                    "paginate": {
                        "next": "Siguiente <i class='fa-solid fa-chevron-right ms-1'></i>",
                        "previous": "<i class='fa-solid fa-chevron-left me-1'></i> Anterior"
                    }
                },
                "pageLength": 10, 
                "lengthMenu": [5, 10, 25, 50],
                "ordering": false // opcion de triangulitos por las dudas lo dejo
            });
        });
    </script>
}