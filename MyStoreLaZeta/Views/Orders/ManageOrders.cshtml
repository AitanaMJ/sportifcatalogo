@model IEnumerable<MyStoreLaZeta.Entities.Order>

<div class="container mt-4 mb-5">
    <h2 class="text-zeta-dark fw-bold mb-4">
        <i class="fa-solid fa-file-invoice-dollar me-2" style="color: var(--zeta-cyan);"></i>
        Administración de Pedidos
    </h2>

    <style>
        .filtro-zeta {
            border: 2px solid var(--zeta-cyan) !important;
            color: var(--zeta-cyan) !important;
            background-color: transparent !important;
            border-radius: 50px !important;
            font-weight: 600 !important;
            transition: all 0.3s ease;
        }

            .filtro-zeta:hover {
                background-color: rgba(23, 160, 156, 0.1) !important;
                color: var(--zeta-cyan) !important;
            }

            .filtro-zeta.active {
                background-color: var(--zeta-cyan) !important;
                color: white !important;
                box-shadow: 0 4px 10px rgba(23, 160, 156, 0.4) !important;
            }
    </style>

    <div class="d-flex flex-wrap gap-3 mb-4 bg-light p-3 rounded-3 border align-items-center">
        <span class="fw-bold align-self-center text-muted me-2"><i class="fa-solid fa-filter text-zeta-cyan"></i> Filtros:</span>

        <div class="d-flex flex-wrap gap-2">
            <button type="button" class="btn btn-sm filtro-zeta btn-filter-date active px-3 shadow-sm" data-filter="todos">
                Todas las fechas
            </button>
            <button type="button" class="btn btn-sm filtro-zeta btn-filter-date px-3 shadow-sm" data-filter="hoy">
                <i class="fa-regular fa-calendar-star me-1"></i> Solo Hoy
            </button>
        </div>

        <div class="vr d-none d-md-block mx-2"></div>

        <div class="d-flex align-items-center gap-2">
            <span class="fw-bold text-muted small mb-0">Estado:</span>
            <select id="selectStatusFilter" class="form-select form-select-sm shadow-sm" style="border-radius: 50px; border: 2px solid var(--zeta-cyan); color: var(--zeta-cyan); font-weight: 600; width: auto; cursor: pointer;">
                <option value="todos">Todos los estados</option>
                <option value="pendiente">Solo Pendientes</option>
                <option value="en preparación">En Preparación</option>
                <option value="enviado">Enviados</option>
                <option value="entregado">Entregados</option>
                <option value="cancelado">Cancelados</option>
            </select>
        </div>
    </div>

    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css">
    <style>
        .dataTables_filter input {
            border-radius: 50px !important;
            border: 1px solid #ced4da !important;
            padding: 6px 20px !important;
            margin-left: 10px !important;
            transition: all 0.3s ease;
        }

            .dataTables_filter input:focus {
                border-color: var(--zeta-cyan) !important;
                box-shadow: 0 0 0 0.25rem rgba(23, 160, 156, 0.25) !important;
                outline: none !important;
            }

        .dataTables_length select {
            border-radius: 10px !important;
            padding: 4px 30px 4px 10px !important;
            border: 1px solid #ced4da !important;
        }

        .dataTables_wrapper .pagination {
            margin-top: 20px !important;
        }

        .dataTables_wrapper .page-item.active .page-link {
            background-color: var(--zeta-cyan) !important;
            border-color: var(--zeta-cyan) !important;
            color: white !important;
            border-radius: 50px !important;
            box-shadow: 0 4px 10px rgba(23, 160, 156, 0.3) !important;
        }

        .dataTables_wrapper .page-item .page-link {
            border: none !important;
            color: #555;
            font-weight: 600;
            border-radius: 50px !important;
            margin: 0 3px;
            padding: 8px 16px;
            background-color: transparent;
        }

        .dataTables_wrapper .page-item:not(.active) .page-link:hover {
            background-color: #f8f9fa !important;
            color: var(--zeta-cyan) !important;
        }
    </style>

    <div class="table-responsive">
        <table id="tablaPedidos" class="table table-hover align-middle table-zeta">
            <thead class="bg-light">
                <tr>
                    <th style="width: 80px;">#ID</th>
                    <th>Cliente</th>
                    <th class="text-center">Fecha</th>
                    <th class="text-end">Total</th>
                    <th class="text-center">Envío</th>
                    <th class="text-center">Estado</th>
                    <th class="text-end" style="width: 80px;">Acción</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    var orderDateStr = item.OrderDate.ToString("dd/MM/yyyy");
                    var statusClass = item.Status.ToLower();

                    <tr data-order-date="@orderDateStr" data-order-status="@statusClass">
                        <td class="fw-bold text-muted">#@item.OrderId</td>
                        <td>
                            <div class="fw-bold text-zeta-dark">@item.ClientName</div>
                            <small class="text-muted"><i class="fa-regular fa-envelope me-1"></i>@item.Email</small>
                        </td>
                        <td class="text-center">@item.OrderDate.ToString("dd/MM/yy HH:mm")</td>
                        <td class="text-success fw-bold text-end">$@item.TotalAmount.ToString("N0")</td>

                        <td class="text-center">
                            @if (item.ShippingMethod == "Retiro")
                            {
                                <div class="d-flex flex-column align-items-center">
                                    <span class="badge bg-light text-dark border shadow-sm mb-1">
                                        <i class="fa-solid fa-store text-muted me-1"></i> Retiro en Local
                                    </span>
                                </div>
                            }
                            else
                            {
                                <div class="d-flex flex-column align-items-center">
                                    <span class="badge text-white shadow-sm mb-1" style="background-color: var(--zeta-cyan);">
                                        <i class="fa-solid fa-motorcycle me-1"></i> Envío a Domicilio
                                    </span>
                                    <small class="text-muted text-wrap mt-1" style="max-width: 180px; font-size: 0.8rem; line-height: 1.2;">
                                        <i class="fa-solid fa-location-dot text-danger me-1"></i>@item.Address
                                    </small>
                                </div>
                            }
                        </td>
                        <td class="text-center">
                            @if (item.Status == "Pendiente")
                            {
                                <span class="badge bg-warning text-dark px-3 rounded-pill shadow-sm"><i class="fa-solid fa-clock me-1"></i>Pendiente</span>
                            }
                            else if (item.Status == "Cancelado")
                            {
                                <span class="badge bg-danger px-3 rounded-pill shadow-sm"><i class="fa-solid fa-xmark me-1"></i>Cancelado</span>
                            }
                            else if (item.Status == "Entregado")
                            {
                                <span class="badge bg-success px-3 rounded-pill shadow-sm"><i class="fa-solid fa-check-double me-1"></i>Entregado</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary px-3 rounded-pill shadow-sm">@item.Status</span>
                            }
                        </td>
                        <td class="text-end">
                            <a asp-action="Details" asp-route-id="@item.OrderId" class="btn btn-sm btn-zeta-cyan text-white shadow-sm" title="Ver detalle">
                                <i class="fa-solid fa-eye"></i>
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>

    <script>
        $(document).ready(function() {
            // 1. Calculamos la fecha de hoy
            const today = new Date();
            const yyyy = today.getFullYear();
            let mm = today.getMonth() + 1;
            let dd = today.getDate();
            if (dd < 10) dd = '0' + dd;
            if (mm < 10) mm = '0' + mm;
            const formattedToday = dd + '/' + mm + '/' + yyyy;

            // 2. Restauramos lo guardado en SessionStorage (si hay algo)
            var savedDate = sessionStorage.getItem('zetaDateFilter') || 'todos';
            var savedStatus = sessionStorage.getItem('zetaStatusFilter') || 'todos';

            // Actualizamos la vista antes de cargar la tabla
            $('.btn-filter-date').removeClass('active');
            $('.btn-filter-date[data-filter="' + savedDate + '"]').addClass('active');
            $('#selectStatusFilter').val(savedStatus);

            // Limpiamos cualquier filtro previo trabado
            $.fn.dataTable.ext.search = [];

            // 3. NUEVA LOGICA: Lee el DOM en tiempo real
            $.fn.dataTable.ext.search.push(
                function(settings, data, dataIndex, rowData, counter) {
                    var tr = $(settings.aoData[dataIndex].nTr);
                    if (!tr) return true;

                    var orderDate = tr.attr('data-order-date');
                    var orderStatus = (tr.attr('data-order-status') || '').toLowerCase().trim();

                    // Leemos qué está seleccionado AHORA MISMO en los botones y el select
                    var currentStatus = $('#selectStatusFilter').val();
                    var currentDate = $('.btn-filter-date.active').data('filter');

                    var cumpleFecha = (currentDate === 'todos') || (currentDate === 'hoy' && orderDate === formattedToday);
                    var cumpleEstado = (currentStatus === 'todos') || (orderStatus === currentStatus);

                    return cumpleFecha && cumpleEstado;
                }
            );

            // 4. Inicializamos DataTables
            var table = $('#tablaPedidos').DataTable({
                "language": {
                    "lengthMenu": "Mostrar _MENU_ pedidos",
                    "zeroRecords": "No se encontraron pedidos",
                    "info": "Mostrando _START_ a _END_ de _TOTAL_ pedidos",
                    "infoEmpty": "No hay pedidos",
                    "infoFiltered": "(filtrado de _MAX_ totales)",
                    "search": "Buscar:",
                    "paginate": {
                        "next": "Siguiente <i class='fa-solid fa-chevron-right ms-1'></i>",
                        "previous": "<i class='fa-solid fa-chevron-left me-1'></i> Anterior"
                    }
                },
                "pageLength": 10,
                "lengthMenu": [5, 10, 25, 50],
                "ordering": false,
                "stateSave": true
            });

            // 5. Eventos: Guardamos en storage y redibujamos
            $('.btn-filter-date').on('click', function() {
                $('.btn-filter-date').removeClass('active');
                $(this).addClass('active');
                sessionStorage.setItem('zetaDateFilter', $(this).data('filter'));
                table.draw();
            });

            $('#selectStatusFilter').on('change', function() {
                sessionStorage.setItem('zetaStatusFilter', $(this).val());
                table.draw();
            });
        });
    </script>
}