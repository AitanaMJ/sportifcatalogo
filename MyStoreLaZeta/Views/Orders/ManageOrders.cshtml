@model IEnumerable<MyStoreLaZeta.Entities.Order>

<div class="container-fluid mt-4 mb-5">
    <div class="card card-zeta p-4 shadow-sm border-0">
    <h2 class="text-zeta-dark fw-bold mb-4">
        <i class="fa-solid fa-file-invoice-dollar me-2" style="color: var(--zeta-cyan);"></i>
        Administración de Pedidos
    </h2>

    <style>
            .filtro-zeta {
                border: 2px solid var(--zeta-cyan) !important;
                color: var(--zeta-cyan) !important;
                background-color: transparent !important;
                border-radius: 50px !important;
                font-weight: 600 !important;
                transition: all 0.3s ease;
            }

                .filtro-zeta:hover {
                    background-color: rgba(23, 160, 156, 0.1) !important;
                    color: var(--zeta-cyan) !important;
                }

                .filtro-zeta.active {
                    background-color: var(--zeta-cyan) !important;
                    color: white !important;
                    box-shadow: 0 4px 10px rgba(23, 160, 156, 0.4) !important;
                }
    </style>

    @* SECCIÓN DE FILTROS - TRES BOTONES *@
    @* SECCIÓN DE FILTROS - ESTILO PRODUCTOS *@
        <div class="d-flex flex-wrap gap-3 mb-4 bg-white p-3 rounded-4 shadow-sm border-0 align-items-center justify-content-between">
        <div class="d-flex align-items-center gap-3">
            <span class="fw-bold text-muted me-2">
                <i class="fa-solid fa-filter text-zeta-cyan"></i> Filtros:
            </span>

            <div class="d-flex flex-wrap gap-2">
                <button type="button" class="btn btn-sm filtro-zeta btn-filter-date active px-3 shadow-sm" data-filter="hoy">
                    <i class="fa-solid fa-calendar-day me-1"></i> Pedidos de Hoy
                </button>
                <button type="button" class="btn btn-sm filtro-zeta btn-filter-date px-3 shadow-sm" data-filter="urgente">
                    <i class="fa-solid fa-spinner fa-spin-pulse me-1"></i> Pendientes y En preparación
                </button>
                <button type="button" class="btn btn-sm filtro-zeta btn-filter-date px-3 shadow-sm" data-filter="todos">
                    <i class="fa-solid fa-clock-rotate-left me-1"></i> Historial
                </button>
            </div>
        </div>

        <div class="d-flex align-items-center gap-2">
            <span class="fw-bold text-muted small mb-0">Estado:</span>
            <select id="selectStatusFilter" class="form-select form-select-sm shadow-sm" style="border-radius: 50px; border: 2px solid var(--zeta-cyan); color: var(--zeta-cyan); font-weight: 600; width: auto; cursor: pointer;">
                <option value="todos">Todos los estados</option>
                <option value="pendiente">Solo Pendientes</option>
                <option value="en preparación">En Preparación</option>
                <option value="enviado">Enviados</option>
                <option value="entregado">Entregados</option>
                <option value="cancelado">Cancelados</option>
            </select>
        </div>
    </div>

    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css">
    <style>
            .dataTables_filter input {
                border-radius: 50px !important;
                border: 1px solid #ced4da !important;
                padding: 6px 20px !important;
                margin-left: 10px !important;
                transition: all 0.3s ease;
            }

                .dataTables_filter input:focus {
                    border-color: var(--zeta-cyan) !important;
                    box-shadow: 0 0 0 0.25rem rgba(23, 160, 156, 0.25) !important;
                    outline: none !important;
                }

            .dataTables_wrapper .page-item.active .page-link {
                background-color: var(--zeta-cyan) !important;
                border-color: var(--zeta-cyan) !important;
                border-radius: 50px !important;
            }

            .dataTables_wrapper .page-item .page-link {
                border-radius: 50px !important;
                margin: 0 3px;
            }

        .dataTables_wrapper .page-item:not(.active) .page-link:hover {
            background-color: #f8f9fa !important;
            color: var(--zeta-cyan) !important;
        }

            /* Media Query corregida con cierre */
            @@media (max-width: 768px) {
                .d-flex.flex-wrap.gap-3.mb-4 {
                    flex-direction: column;
                    align-items: stretch !important;
                }

                #selectStatusFilter {
                    width: 100% !important;
                }
            }
    </style>

    <div class="table-responsive">
        <table id="tablaPedidos" class="table table-hover align-middle table-zeta">
            <thead class="bg-light">
                <tr>
                    <th style="width: 80px;">#ID</th>
                    <th>Cliente</th>
                    <th class="text-center">Fecha</th>
                    <th class="text-end">Total</th>
                    <th class="text-center">Envío</th>
                    <th class="text-center">Estado</th>
                    <th class="text-end" style="width: 80px;">Acción</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    var orderDateStr = item.OrderDate.ToString("dd/MM/yyyy");
                    var statusClass = item.Status.ToLower();

                    <tr data-order-date="@orderDateStr" data-order-status="@statusClass">
                        <td class="fw-bold text-muted">#@item.OrderId</td>
                        <td>
                            <div class="fw-bold text-zeta-dark">@item.ClientName</div>
                            <small class="text-muted"><i class="fa-regular fa-envelope me-1"></i>@item.Email</small>
                        </td>
                        <td class="text-center">@item.OrderDate.ToString("dd/MM/yy HH:mm")</td>
                        <td class="text-success fw-bold text-end">$@item.TotalAmount.ToString("N0")</td>

                        <td class="text-center">
                            @if (item.ShippingMethod == "Retiro")
                            {
                                <div class="d-flex flex-column align-items-center">
                                    <span class="badge bg-light text-dark border shadow-sm mb-1">
                                        <i class="fa-solid fa-store text-muted me-1"></i> Retiro en Local
                                    </span>
                                </div>
                            }
                            else
                            {
                                <div class="d-flex flex-column align-items-center">
                                    <span class="badge text-white shadow-sm mb-1" style="background-color: var(--zeta-cyan);">
                                        <i class="fa-solid fa-motorcycle me-1"></i> Envío a Domicilio
                                    </span>
                                    <small class="text-muted text-wrap mt-1" style="max-width: 180px; font-size: 0.8rem; line-height: 1.2;">
                                        <i class="fa-solid fa-location-dot text-danger me-1"></i>@item.Address
                                    </small>
                                </div>
                            }
                        </td>
                        <td class="text-center">
                            @if (item.Status == "Pendiente")
                            {
                                <span class="badge bg-warning text-dark px-3 rounded-pill shadow-sm"><i class="fa-solid fa-clock me-1"></i>Pendiente</span>
                            }
                            else if (item.Status == "Cancelado")
                            {
                                <span class="badge bg-danger px-3 rounded-pill shadow-sm"><i class="fa-solid fa-xmark me-1"></i>Cancelado</span>
                            }
                            else if (item.Status == "Entregado")
                            {
                                <span class="badge bg-success px-3 rounded-pill shadow-sm"><i class="fa-solid fa-check-double me-1"></i>Entregado</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary px-3 rounded-pill shadow-sm">@item.Status</span>
                            }
                        </td>
                        <td class="text-end">
                            <a asp-action="Details" asp-route-id="@item.OrderId" class="btn btn-sm btn-zeta-cyan text-white shadow-sm" title="Ver detalle">
                                <i class="fa-solid fa-eye"></i>
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>
    <link rel="stylesheet" href="https://cdn.datatables.net/responsive/2.5.0/css/responsive.dataTables.min.css">
    <script src="https://cdn.datatables.net/responsive/2.5.0/js/dataTables.responsive.min.js"></script>

    <script>
                  $(document).ready(function() {
                // 1. Fecha de hoy (dd/mm/yyyy)
                const now = new Date();
                const formattedToday =
                    ("0" + now.getDate()).slice(-2) + "/" +
                    ("0" + (now.getMonth() + 1)).slice(-2) + "/" +
                    now.getFullYear();

                // 2. Limpieza total de filtros de DataTables al cargar
                $.fn.dataTable.ext.search = [];

                // 3. La Lógica de Filtrado
                $.fn.dataTable.ext.search.push(
                    function(settings, data, dataIndex) {
                        const tr = $(settings.aoData[dataIndex].nTr);
                        const orderDate = tr.attr('data-order-date'); // dd/mm/yyyy
                        const orderStatus = (tr.attr('data-order-status') || '').toLowerCase().trim();

                        const currentBtn = $('.btn-filter-date.active').data('filter');
                        const currentStatusSelect = $('#selectStatusFilter').val().toLowerCase();

                        // LÓGICA DE BOTONES SUPERIORES
                        if (currentBtn === 'hoy') {
                            return (orderDate === formattedToday);
                        }

                        if (currentBtn === 'urgente') {
                            return (orderStatus === 'pendiente' || orderStatus === 'en preparación');
                        }

                        if (currentBtn === 'todos') {
                            // Filtro cruzado con el SELECT
                            if (currentStatusSelect === 'todos') return true;
                            return (orderStatus === currentStatusSelect);
                        }

                        return true;
                    }
                );

                // 4. Inicializar DataTables
                var table = $('#tablaPedidos').DataTable({
                    "responsive": true,
                    "stateSave": false, // DESACTIVADO para que no te trabe filtros viejos
                    "language": {
                        "search": "Buscar:",
                        "zeroRecords": "No hay pedidos hoy",
                        "info": "Mostrando _START_ a _END_ de _TOTAL_ pedidos",
                        "paginate": { "next": "Sig.", "previous": "Ant." }
                    },
                    "pageLength": 10,
                    "ordering": false
                });

                // 5. Evento para los BOTONES
                $('.btn-filter-date').on('click', function() {
                    $('.btn-filter-date').removeClass('active');
                    $(this).addClass('active');

                    const filtro = $(this).data('filter');

                    // Bloqueamos/Desbloqueamos el select según corresponda
                    if (filtro === 'todos') {
                        $('#selectStatusFilter').prop('disabled', false).css('opacity', '1');
                    } else {
                        $('#selectStatusFilter').val('todos').prop('disabled', true).css('opacity', '0.5');
                    }

                    table.draw(); // Esto activa la lógica del push de arriba
                });

                // 6. Evento para el SELECT (Solo anda en Historial)
                $('#selectStatusFilter').on('change', function() {
                    table.draw();
                });

                // Primer dibujado forzado
                table.draw();
            });
    </script>
}