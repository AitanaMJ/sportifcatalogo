@model IEnumerable<MyStoreLaZeta.Entities.Order>

<div class="container mt-5 mb-5">
    <h2 class="text-zeta-dark mb-4 fw-bold">
        <i class="fa-solid fa-bag-shopping text-zeta-cyan me-2"></i>Mis Compras
    </h2>

    @if (!Model.Any())
    {
        <div class="card shadow-sm border-0 p-5 text-center" style="border-radius: 15px;">
            <div class="mb-3">
                <i class="fa-solid fa-cart-ghost text-muted opacity-25" style="font-size: 5rem;"></i>
            </div>
            <h4 class="text-muted">Aún no has realizado ninguna compra.</h4>
            <p class="text-muted mb-4">¡Explora nuestro catálogo y encuentra algo para vos!</p>
            <div class="d-flex justify-content-center">
                <a asp-controller="Home" asp-action="Catalogo" class="btn btn-zeta-orange px-4 py-2 shadow-sm text-white fw-bold">
                    Ir al Catálogo
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="card shadow-sm border-0 p-4" style="border-radius: 15px;">
            <div class="table-responsive">
                <table id="tablaMisCompras" class="table table-hover align-middle mb-0" style="width:100%">
                    <thead class="bg-light">
                        <tr>
                            <th class="ps-4 py-3 border-0">Fecha</th>
                            <th class="py-3 border-0">Total</th>
                            <th class="py-3 border-0">Estado</th>
                            <th class="text-end pe-4 py-3 border-0">Acción</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4">
                                    <span class="d-none">@item.OrderDate.ToString("yyyyMMddHHmm")</span>
                                    @item.OrderDate.ToString("dd/MM/yyyy HH:mm")
                                </td>
                                <td class="fw-bold text-zeta-dark">
                                    $@item.TotalAmount.ToString("N2")
                                </td>
                                <td>
                                    @{
                                        var badgeClass = item.Status switch
                                        {
                                            "Pendiente" => "bg-warning text-dark",
                                            "En Preparación" => "bg-info text-white",
                                            "Enviado" => "bg-primary text-white",
                                            "Entregado" => "bg-success text-white",
                                            _ => "bg-secondary text-white"
                                        };
                                    }
                                    <span class="badge rounded-pill @badgeClass px-3 py-2">@item.Status</span>
                                </td>
                                <td class="text-end pe-4">
                                    <a asp-action="Details" asp-route-id="@item.OrderId" class="btn-minimal-zeta">
                                        Ver detalle <i class="fa-solid fa-arrow-right ms-1" style="font-size: 0.75rem;"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

<style>
    /* Buscador redondeado estilo píldora */
    .dataTables_wrapper .dataTables_filter {
        margin-bottom: 25px;
    }

        .dataTables_wrapper .dataTables_filter input {
            border-radius: 50px !important; /* Ahora es bien redondo */
            border: 1px solid #ddd !important;
            padding: 8px 20px !important;
            width: 250px !important;
            background-color: #fcfcfc;
            outline: none !important;
            transition: all 0.3s ease;
        }

            .dataTables_wrapper .dataTables_filter input:focus {
                border-color: var(--zeta-cyan) !important;
                box-shadow: 0 0 0 0.2rem rgba(23, 160, 156, 0.1) !important;
            }

    /* Acción Minimalista */
    .btn-minimal-zeta {
        color: var(--zeta-cyan);
        text-decoration: none;
        font-weight: 600;
        font-size: 0.85rem;
        padding: 5px 0;
        border-bottom: 2px solid transparent;
        transition: all 0.3s ease;
    }

        .btn-minimal-zeta:hover {
            color: var(--zeta-orange);
            border-bottom: 2px solid var(--zeta-orange);
        }

    /* Paginación minimalista y corregida */
    .dataTables_wrapper .dataTables_paginate {
        margin-top: 25px !important;
        display: flex;
        justify-content: flex-end;
    }

    .dataTables_wrapper .page-item .page-link {
        border: none !important;
        color: #666 !important;
        background: none !important;
        font-size: 0.9rem;
        margin: 0 5px;
        padding: 5px 10px;
    }

    .dataTables_wrapper .page-item.active .page-link {
        color: var(--zeta-cyan) !important;
        font-weight: bold !important;
        border-bottom: 2px solid var(--zeta-cyan) !important;
        border-radius: 0 !important;
    }

    .dataTables_info {
        margin-top: 25px !important;
        font-size: 0.85rem;
        color: #888;
    }
</style>

@section Scripts {
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>

    <script>
        $(document).ready(function() {
            $('#tablaMisCompras').DataTable({
                "pageLength": 5,
                "order": [[0, "desc"]],
                "language": {
                    "lengthMenu": "Mostrar _MENU_",
                    "zeroRecords": "No hay pedidos",
                    "info": "Mostrando _START_ a _END_ de _TOTAL_ compras",
                    "infoEmpty": "",
                    "search": "Buscar:",
                    "paginate": {
                        "next": "Siguiente",
                        "previous": "Anterior"
                    }
                },
                "dom": '<"d-flex justify-content-end mb-2"f>rt<"d-flex justify-content-between align-items-center"ip>'
            });
        });
    </script>
}