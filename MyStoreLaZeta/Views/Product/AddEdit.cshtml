@model MyStoreLaZeta.Models.ProductVM

@{
    var title = Model.ProductId == 0 ? "Nuevo Producto" : "Editar Producto";
    var btnAction = Model.ProductId == 0 ? "Agregar Producto" : "Guardar Cambios";
    var icon = Model.ProductId == 0 ? "fa-circle-plus" : "fa-pen-to-square";
}

<div class="container mt-4">
    <div class="card card-zeta shadow-sm border-0">
        <div class="card-body p-4 p-md-5">

            <div class="row mb-4">
                <div class="col-12 border-bottom pb-3 d-flex align-items-center">
                    <div class="rounded-circle bg-light d-flex align-items-center justify-content-center me-3" style="width: 50px; height: 50px;">
                        <i class="fa-solid @icon fa-xl" style="color: var(--zeta-cyan);"></i>
                    </div>
                    <div>
                        <h2 class="fw-bold m-0 text-zeta-dark">@title</h2>
                        <p class="text-muted mb-0">Gestiona los detalles, precios y stock de tu inventario.</p>
                    </div>
                </div>
            </div>

            @if (ViewBag.message != null)
            {
                <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm mb-4" role="alert" style="border-left: 5px solid #28a745 !important;">
                    <i class="fa-solid fa-check-circle me-2"></i> @ViewBag.message
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            <form asp-action="AddEdit" method="post" enctype="multipart/form-data">
                <input type="hidden" asp-for="ProductId" />

                <div class="row">
                    <div class="col-lg-7 pe-lg-5">

                        <div class="mb-3">
                            <label class="form-label fw-bold">Categoría</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light"><i class="fa-solid fa-tags text-muted"></i></span>
                                <select class="form-select" asp-for="Category.CategoryId" asp-items="Model.Categories">
                                    <option selected disabled>-- Selecciona una categoría --</option>
                                </select>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Nombre del Producto</label>
                            <input type="text" class="form-control" asp-for="Name" placeholder="Ej: Taza Mágica La Zeta" autocomplete="off">
                            <span asp-validation-for="Name" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Descripción</label>
                            <textarea class="form-control" asp-for="Description" rows="3" placeholder="Describe brevemente el producto..."></textarea>
                            <span asp-validation-for="Description" class="text-danger small"></span>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold">Precio (ARS)</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light"><i class="fa-solid fa-dollar-sign text-muted"></i></span>
                                    <input type="number" class="form-control" asp-for="Price" step="0.01" autocomplete="off">
                                </div>
                                <span asp-validation-for="Price" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold">Stock Disponible</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light"><i class="fa-solid fa-layer-group text-muted"></i></span>
                                    <input type="number" class="form-control" asp-for="Stock" autocomplete="off">
                                </div>
                                <span asp-validation-for="Stock" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-bold">Actualizar Imagen</label>
                            <div class="input-group">
                                <input type="file" class="form-control" asp-for="ImageFile" id="inputGroupFile02">
                                <label class="input-group-text bg-light" for="inputGroupFile02"><i class="fa-solid fa-upload"></i></label>
                            </div>
                            <small class="text-muted">Formatos aceptados: JPG, PNG. Máximo 2MB.</small>
                        </div>

                        <div class="d-grid gap-2 d-md-flex mt-4">
                            <button class="btn btn-zeta-cyan px-5 py-2 shadow-sm" type="submit">
                                <i class="fa-solid fa-save me-2"></i>@btnAction
                            </button>
                            <a asp-action="Index" class="btn btn-outline-secondary px-4 py-2">
                                <i class="fa-solid fa-arrow-left me-2"></i>Volver
                            </a>
                        </div>
                    </div>

                    <div class="col-lg-5 mt-4 mt-lg-0 border-start ps-lg-5 d-flex flex-column align-items-center justify-content-start">
                        <h6 class="text-uppercase fw-bold text-muted small mb-3">Vista Previa de Imagen</h6>

                        @if (!string.IsNullOrEmpty(Model.ImageName))
                        {
                            <div class="image-container shadow-sm p-2 bg-white rounded border">
                                <img src="~/images/@Model.ImageName" class="img-fluid rounded" style="max-height: 350px; object-fit: contain;" alt="@Model.Name" />
                            </div>
                            <p class="mt-2 text-muted x-small italic">Archivo actual: @Model.ImageName</p>
                        }
                        else
                        {
                            <div class="d-flex flex-column align-items-center justify-content-center border rounded bg-light w-100" style="height: 300px; border-style: dashed !important;">
                                <i class="fa-solid fa-image fa-3x text-muted mb-3"></i>
                                <p class="text-muted">Sin imagen cargada</p>
                            </div>
                        }
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}