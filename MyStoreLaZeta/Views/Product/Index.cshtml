@model List<ProductVM>

<div class="container-fluid mt-4">
    <div class="card card-zeta p-4 shadow-sm">

        <div class="row align-items-center mb-4">
            <div class="col-md-6">
                <h2 class="fw-bold m-0 text-zeta-dark">
                    <i class="fa-solid fa-boxes-stacked me-2" style="color: var(--zeta-cyan);"></i>
                    Gestión de Productos
                </h2>
            </div>
            <div class="col-md-6 text-end">
                <a href="/Product/AddEdit" class="btn btn-zeta-orange shadow-sm px-4">
                    <i class="fa-solid fa-plus me-2"></i>Crear Producto
                </a>
            </div>
        </div>

        @if (TempData["message"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show mb-4 border-0 shadow-sm" role="alert" style="border-left: 5px solid #28a745 !important;">
                <i class="fa-solid fa-check-circle me-2"></i> @TempData["message"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }


        <style>
            /* Caja de Búsqueda redondeada */
            .dataTables_filter input {
                border-radius: 50px !important;
                border: 1px solid #ced4da !important;
                padding: 6px 20px !important;
                margin-left: 10px !important;
                transition: all 0.3s ease;
            }

                .dataTables_filter input:focus {
                    border-color: var(--zeta-cyan) !important;
                    box-shadow: 0 0 0 0.25rem rgba(23, 160, 156, 0.25) !important;
                    outline: none !important;
                }

            /* Selector de cantidad */
            .dataTables_length select {
                border-radius: 10px !important;
                padding: 4px 30px 4px 10px !important;
                border: 1px solid #ced4da !important;
            }

            /* Diseño de la Paginación (Estilo pastilla) */
            .dataTables_wrapper .pagination {
                margin-top: 20px !important;
            }

            .dataTables_wrapper .page-item.active .page-link {
                background-color: var(--zeta-cyan) !important;
                border-color: var(--zeta-cyan) !important;
                color: white !important;
                border-radius: 50px !important;
                box-shadow: 0 4px 10px rgba(23, 160, 156, 0.3) !important;
            }

            .dataTables_wrapper .page-item .page-link {
                border: none !important;
                color: #555;
                font-weight: 600;
                border-radius: 50px !important;
                margin: 0 3px;
                padding: 8px 16px;
                background-color: transparent;
            }

            .dataTables_wrapper .page-item:not(.active) .page-link:hover {
                background-color: #f8f9fa !important;
                color: var(--zeta-cyan) !important;
            }
        </style>





        <div class="table-responsive">
            <table id="tablaProductos" class="table table-zeta align-middle">
                <thead>
                    <tr>
                        <th>Nombre</th>
                        <th>Categoría</th>
                        <th class="text-center">Precio</th>
                        <th class="text-center">Stock</th>
                        <th class="text-end" style="width:140px">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="fw-bold text-zeta-dark">@item.Name</td>
                            <td>
                                <span class="badge rounded-pill bg-light text-dark border px-3">
                                    <i class="fa-solid fa-tag me-1 text-muted small"></i> @item.Category.Name
                                </span>
                            </td>
                            <td class="text-center fw-bold" style="color: var(--zeta-cyan);">
                                $@item.Price.ToString("N2")
                            </td>
                            <td class="text-center">
                                <span class="badge @(item.Stock <= 5 ? "bg-danger" : "bg-dark")">
                                    @item.Stock un.
                                </span>
                            </td>
                            <td class="text-end">
                                <a asp-controller="Product"
                                   asp-action="AddEdit"
                                   asp-route-id="@item.ProductId"
                                   class="btn btn-sm btn-zeta-cyan text-white shadow-sm me-1">
                                    <i class="fa-solid fa-pen-to-square"></i>
                                </a>
                                <button class="btn btn-sm btn-outline-danger shadow-sm" onclick="deleteItem(@item.ProductId)">
                                    <i class="fa-solid fa-trash"></i>
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function deleteItem(id) {
            Swal.fire({
                title: "¿Estás seguro?",
                text: "Esta acción no se puede deshacer.",
                icon: "warning",
                showCancelButton: true,
                confirmButtonColor: "#EB5D0B", // Tu Naranja Corporativo
                cancelButtonColor: "#6c757d",
                confirmButtonText: "Sí, eliminar",
                cancelButtonText: "No, volver",
                reverseButtons: true
            }).then((result) => {
                if (result.isConfirmed) {
                    window.location.href = '@Url.Action("Delete", "Product")' + '?id=' + id;
                }
            });
        }
    </script>

    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>

    <script>
        $(document).ready(function() {
            $('#tablaProductos').DataTable({
                "language": {
                    "lengthMenu": "Mostrar _MENU_ productos",
                    "zeroRecords": "No se encontraron productos",
                    "info": "Mostrando _START_ a _END_ de _TOTAL_ productos",
                    "infoEmpty": "No hay productos disponibles",
                    "infoFiltered": "(filtrado de _MAX_ totales)",
                    "search": "Buscar:",
                    "paginate": {
                        "next": "Siguiente <i class='fa-solid fa-chevron-right ms-1'></i>",
                        "previous": "<i class='fa-solid fa-chevron-left me-1'></i> Anterior"
                    }
                },
                "pageLength": 5,
                "lengthMenu": [5, 10, 25, 50],
                "ordering": false,
                "columnDefs": [
                    { "orderable": false, "targets": -1 }
                ]
            });
        });
    </script>



}

<link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css">

