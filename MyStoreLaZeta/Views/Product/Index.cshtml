@model List<ProductVM>

<div class="container-fluid mt-4 mb-5">
    <div class="card card-zeta p-4 shadow-sm border-0">

        <div class="row align-items-center mb-4">
            <div class="col-md-6">
                <h2 class="fw-bold m-0 text-zeta-dark">
                    <i class="fa-solid fa-boxes-stacked me-2" style="color: var(--zeta-cyan);"></i>
                    Gestión de Productos
                </h2>
            </div>
            <div class="col-md-6 text-end">
                <a href="/Product/AddEdit" class="btn btn-zeta-orange shadow-sm px-4">
                    <i class="fa-solid fa-plus me-2"></i>Crear Producto
                </a>
            </div>
        </div>

        @if (TempData["message"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show mb-4 border-0 shadow-sm" role="alert" style="border-left: 5px solid #28a745 !important;">
                <i class="fa-solid fa-check-circle me-2"></i> @TempData["message"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        <style>
            .filtro-zeta {
                border: 2px solid var(--zeta-cyan) !important;
                color: var(--zeta-cyan) !important;
                background-color: transparent !important;
                border-radius: 50px !important;
                font-weight: 600 !important;
                transition: all 0.3s ease;
            }

                .filtro-zeta:hover {
                    background-color: rgba(23, 160, 156, 0.1) !important;
                    color: var(--zeta-cyan) !important;
                }

                .filtro-zeta.active {
                    background-color: var(--zeta-cyan) !important;
                    color: white !important;
                    box-shadow: 0 4px 10px rgba(23, 160, 156, 0.4) !important;
                }
        </style>

        @* SECCIÓN DE FILTROS ACTUALIZADA *@
        <div class="d-flex flex-wrap gap-3 mb-4 bg-white p-3 rounded-4 shadow-sm border-0 align-items-center">
            <span class="fw-bold text-muted me-2">
                <i class="fa-solid fa-filter text-zeta-cyan"></i> Filtros:
            </span>

            <div class="d-flex flex-wrap gap-2">
                <button type="button" class="btn btn-sm filtro-zeta btn-filter-sale active px-3 shadow-sm" data-filter="todos">
                    Todas
                </button>
                <button type="button" class="btn btn-sm filtro-zeta btn-filter-sale px-3 shadow-sm" data-filter="venta">
                    <i class="fa-solid fa-store me-1"></i> A la venta
                </button>
                <button type="button" class="btn btn-sm filtro-zeta btn-filter-sale px-3 shadow-sm" data-filter="noventa">
                    <i class="fa-solid fa-eye-slash me-1"></i> No a la venta
                </button>
            </div>

            <div class="vr d-none d-md-block mx-2"></div>

            <div class="d-flex align-items-center gap-2">
                <span class="fw-bold text-muted small mb-0">Stock:</span>
                <select id="selectStockFilter" class="form-select form-select-sm shadow-sm" style="border-radius: 50px; border: 2px solid var(--zeta-cyan); color: var(--zeta-cyan); font-weight: 600; width: auto; cursor: pointer;">
                    <option value="todos">Todos los niveles</option>
                    <option value="sinstock">Sin Stock (0)</option>
                    <option value="pocostock">Poco Stock (1 a 3)</option>
                    <option value="normal">Stock Normal (+4)</option>
                </select>
            </div>
        </div>

        <style>
            .dataTables_filter input {
                border-radius: 50px !important;
                border: 1px solid #ced4da !important;
                padding: 6px 20px !important;
                margin-left: 10px !important;
                transition: all 0.3s ease;
            }

                .dataTables_filter input:focus {
                    border-color: var(--zeta-cyan) !important;
                    box-shadow: 0 0 0 0.25rem rgba(23, 160, 156, 0.25) !important;
                    outline: none !important;
                }

            .dataTables_wrapper .page-item.active .page-link {
                background-color: var(--zeta-cyan) !important;
                border-color: var(--zeta-cyan) !important;
                border-radius: 50px !important;
            }

            .dataTables_wrapper .page-item .page-link {
                border-radius: 50px !important;
                margin: 0 3px;
            }
        </style>

        <div class="table-responsive">
            <table id="tablaProductos" class="table table-zeta align-middle table-hover">
                <thead>
                    <tr>
                        <th>Nombre</th>
                        <th>Categoría</th>
                        <th class="text-center">Estado</th>
                        <th class="text-center">Precio</th>
                        <th class="text-center">Stock</th>
                        <th class="text-end" style="width:140px">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        var isForSale = item.IsActive && item.Stock > 0;
                        var saleStatusData = isForSale ? "venta" : "noventa";

                        // CÁLCULO PARA EL DATA-ATTRIBUTE DE STOCK
                        var stockLevelData = "normal";
                        if (item.Stock == 0) stockLevelData = "sinstock";
                        else if (item.Stock <= 3) stockLevelData = "pocostock";

                        <tr style="@(!item.IsActive ? "opacity: 0.6; background-color: #f8f9fa;" : "")"
                            data-sale-status="@saleStatusData"
                            data-stock-level="@stockLevelData">

                            <td class="fw-bold text-zeta-dark">@item.Name</td>
                            <td>
                                <span class="badge rounded-pill bg-white text-dark border px-3 shadow-sm">
                                    <i class="fa-solid fa-tag me-1 text-muted small"></i> @item.Category.Name
                                </span>
                            </td>
                            <td class="text-center">
                                @if (item.IsActive)
                                {
                                    <span class="badge rounded-pill bg-success px-3">Activo</span>
                                }
                                else
                                {
                                    <span class="badge rounded-pill bg-secondary px-3">Inactivo</span>
                                }
                            </td>
                            <td class="text-center fw-bold" style="color: var(--zeta-cyan);">
                                $@item.Price.ToString("N2")
                            </td>
                            <td class="text-center">
                                @if (item.Stock == 0)
                                {
                                    <span class="badge bg-danger px-3 shadow-sm">
                                        <i class="fa-solid fa-circle-xmark me-1"></i> SIN STOCK
                                    </span>
                                }
                                else if (item.Stock <= 3)
                                {
                                    <span class="badge bg-warning text-dark px-3 shadow-sm animate__animated animate__pulse animate__infinite">
                                        <i class="fa-solid fa-triangle-exclamation me-1"></i> ¡ULTIMAS @item.Stock!
                                    </span>
                                }
                                else
                                {
                                    <span class="badge @(item.Stock <= 10 ? "bg-info text-dark" : "bg-dark") px-3">
                                        @item.Stock un.
                                    </span>
                                }
                            </td>
                            <td class="text-end">
                                <a asp-controller="Product" asp-action="AddEdit" asp-route-id="@item.ProductId"
                                   class="btn btn-sm btn-zeta-cyan text-white shadow-sm me-1" title="Editar">
                                    <i class="fa-solid fa-pen-to-square"></i>
                                </a>

                                <button type="button"
                                        class="btn btn-sm @(item.IsActive ? "btn-outline-danger" : "btn-outline-success") shadow-sm"
                                        onclick="confirmToggle(this, @item.ProductId)"
                                        title="@(item.IsActive ? "Desactivar" : "Activar")">
                                    <i class="fa-solid @(item.IsActive ? "fa-eye-slash" : "fa-eye")"></i>
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css">

@section Scripts {
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>

    <script>
        $(document).ready(function() {

            // Restauramos lo guardado
            var savedSaleFilter = sessionStorage.getItem('zetaProductSaleFilter') || 'todos';
            var savedStockFilter = sessionStorage.getItem('zetaProductStockFilter') || 'todos';

            // Actualizamos la vista inicial
            $('.btn-filter-sale').removeClass('active');
            $('.btn-filter-sale[data-filter="' + savedSaleFilter + '"]').addClass('active');
            $('#selectStockFilter').val(savedStockFilter);

            // Limpiamos filtros trabados
            $.fn.dataTable.ext.search = [];

            // Lógica de búsqueda cruzada en tiempo real
            $.fn.dataTable.ext.search.push(
                function(settings, data, dataIndex, rowData, counter) {
                    var tr = $(settings.aoData[dataIndex].nTr);
                    if (!tr) return true;

                    var saleStatus = tr.attr('data-sale-status');
                    var stockLevel = tr.attr('data-stock-level');

                    var currentSaleFilter = $('.btn-filter-sale.active').data('filter');
                    var currentStockFilter = $('#selectStockFilter').val();

                    var cumpleVenta = (currentSaleFilter === 'todos') || (saleStatus === currentSaleFilter);
                    var cumpleStock = (currentStockFilter === 'todos') || (stockLevel === currentStockFilter);

                    return cumpleVenta && cumpleStock;
                }
            );

            var table = $('#tablaProductos').DataTable({
                "stateSave": true,
                "language": {
                    "lengthMenu": "Mostrar _MENU_ productos",
                    "zeroRecords": "No se encontraron productos con estos filtros",
                    "info": "Mostrando _START_ a _END_ de _TOTAL_ productos",
                    "infoEmpty": "No hay productos disponibles",
                    "infoFiltered": "(filtrado de _MAX_ totales)",
                    "search": "Buscar:",
                    "paginate": {
                        "next": "Sig.",
                        "previous": "Ant."
                    }
                },
                "pageLength": 5,
                "ordering": false
            });

            // Eventos: Guardamos en storage y redibujamos
            $('.btn-filter-sale').on('click', function() {
                $('.btn-filter-sale').removeClass('active');
                $(this).addClass('active');
                sessionStorage.setItem('zetaProductSaleFilter', $(this).data('filter'));
                table.draw();
            });

            $('#selectStockFilter').on('change', function() {
                sessionStorage.setItem('zetaProductStockFilter', $(this).val());
                table.draw();
            });
        });

        function confirmToggle(btn, id) {
            const url = '/Product/ToggleStatus?id=' + id;

            fetch(url, { method: 'POST' })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    location.reload();
                }
            })
            .catch(error => console.error('Error:', error));
        }
    </script>
}
