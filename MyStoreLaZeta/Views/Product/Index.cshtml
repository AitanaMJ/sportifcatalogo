@model List<ProductVM>

<div class="container-fluid mt-4">
    <div class="card card-zeta p-4 shadow-sm">

        <div class="row align-items-center mb-4">
            <div class="col-md-6">
                <h2 class="fw-bold m-0 text-zeta-dark">
                    <i class="fa-solid fa-boxes-stacked me-2" style="color: var(--zeta-cyan);"></i>
                    Gestión de Productos
                </h2>
            </div>
            <div class="col-md-6 text-end">
                <a href="/Product/AddEdit" class="btn btn-zeta-orange shadow-sm px-4">
                    <i class="fa-solid fa-plus me-2"></i>Crear Producto
                </a>
            </div>
        </div>

        @if (TempData["message"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show mb-4 border-0 shadow-sm" role="alert" style="border-left: 5px solid #28a745 !important;">
                <i class="fa-solid fa-check-circle me-2"></i> @TempData["message"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        <style>
            .dataTables_filter input {
                border-radius: 50px !important;
                border: 1px solid #ced4da !important;
                padding: 6px 20px !important;
                margin-left: 10px !important;
                transition: all 0.3s ease;
            }

                .dataTables_filter input:focus {
                    border-color: var(--zeta-cyan) !important;
                    box-shadow: 0 0 0 0.25rem rgba(23, 160, 156, 0.25) !important;
                    outline: none !important;
                }

            .dataTables_wrapper .page-item.active .page-link {
                background-color: var(--zeta-cyan) !important;
                border-color: var(--zeta-cyan) !important;
                border-radius: 50px !important;
            }
        </style>

        <div class="table-responsive">
            <table id="tablaProductos" class="table table-zeta align-middle">
                <thead>
                    <tr>
                        <th>Nombre</th>
                        <th>Categoría</th>
                        <th class="text-center">Estado</th>
                        <th class="text-center">Precio</th>
                        <th class="text-center">Stock</th>
                        <th class="text-end" style="width:140px">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr style="@(!item.IsActive ? "opacity: 0.6; background-color: #f8f9fa;" : "")">
                            <td class="fw-bold text-zeta-dark">@item.Name</td>
                            <td>
                                <span class="badge rounded-pill bg-light text-dark border px-3">
                                    <i class="fa-solid fa-tag me-1 text-muted small"></i> @item.Category.Name
                                </span>
                            </td>
                            <td class="text-center">
                                @if (item.IsActive)
                                {
                                    <span class="badge rounded-pill bg-success px-3">Activo</span>
                                }
                                else
                                {
                                    <span class="badge rounded-pill bg-secondary px-3">Inactivo</span>
                                }
                            </td>
                            <td class="text-center fw-bold" style="color: var(--zeta-cyan);">
                                $@item.Price.ToString("N2")
                            </td>
                            <td class="text-center">
                                @if (item.Stock == 0)
                                {
                                    <span class="badge bg-danger px-3 shadow-sm">
                                        <i class="fa-solid fa-circle-xmark me-1"></i> SIN STOCK
                                    </span>
                                }
                                else if (item.Stock <= 3)
                                                      @* Umbral de alerta *@
                                {
                                    <span class="badge bg-warning text-dark px-3 shadow-sm animate__animated animate__pulse animate__infinite">
                                        <i class="fa-solid fa-triangle-exclamation me-1"></i> ¡ULTIMAS @item.Stock!
                                    </span>
                                }
                                else
                                {
                                    <span class="badge @(item.Stock <= 10 ? "bg-info text-dark" : "bg-dark") px-3">
                                        @item.Stock un.
                                    </span>
                                }
                            </td>
                            <td class="text-end">
                                <a asp-controller="Product" asp-action="AddEdit" asp-route-id="@item.ProductId"
                                   class="btn btn-sm btn-zeta-cyan text-white shadow-sm me-1" title="Editar">
                                    <i class="fa-solid fa-pen-to-square"></i>
                                </a>

                                @* BOTÓN TOGGLE CON AJAX *@
                                <button type="button"
                                        class="btn btn-sm @(item.IsActive ? "btn-outline-danger" : "btn-outline-success") shadow-sm"
                                        onclick="confirmToggle(this, @item.ProductId)"
                                        title="@(item.IsActive ? "Desactivar" : "Activar")">
                                    <i class="fa-solid @(item.IsActive ? "fa-eye-slash" : "fa-eye")"></i>
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>

    <script>
        $(document).ready(function() {
            $('#tablaProductos').DataTable({
                "stateSave": true, // <--- CRUCIAL: Guarda en qué página estabas
                "language": {
                    "lengthMenu": "Mostrar _MENU_ productos",
                    "zeroRecords": "No se encontraron productos",
                    "info": "Mostrando _START_ a _END_ de _TOTAL_ productos",
                    "infoEmpty": "No hay productos disponibles",
                    "search": "Buscar:",
                    "paginate": {
                        "next": "Sig.",
                        "previous": "Ant."
                    }
                },
                "pageLength": 5,
                "ordering": false
            });
        });

                      function confirmToggle(btn, id) {
            // URL directa para evitar errores
            const url = '/Product/ToggleStatus?id=' + id;

            fetch(url, { method: 'POST' })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    // Recargamos pero con stateSave: true NO te vas a mover de página
                    location.reload();
                }
            })
            .catch(error => console.error('Error:', error));
        }
    </script>
}

<link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css">

