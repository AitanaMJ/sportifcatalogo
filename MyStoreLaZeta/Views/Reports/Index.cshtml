@{
    ViewData["Title"] = "Tablero de Control - La Zeta";
}

<div class="container mt-4">
    <div class="row mb-4 align-items-center">
        <div class="col-md-6">
            <h2 class="text-zeta-dark fw-bold m-0">Tablero de Control</h2>
        </div>
        <div class="col-md-6 text-end">
            <div class="btn-group shadow-sm" role="group">
                <!-- Botón Ventas -->
                <a asp-action="ExportarExcel" asp-route-mesFiltro="@ViewBag.MesFiltro"
                   class="btn btn-success px-3" title="Reporte contable mensual">
                    <i class="fa-solid fa-file-invoice-dollar me-2"></i>Excel Ventas
                </a>

                <!-- Botón Pedidos -->
                <a asp-action="ExportarExcelLogistica"
                   class="btn btn-zeta-cyan text-white px-3" title="Hoja de armado para el depósito">
                    <i class="fa-solid fa-boxes-packing me-2"></i>Excel Pedidos
                </a>
            </div>
        </div>
    </div>

    <!-- Filtro de fecha abajo de los botones para que no se amontone todo -->
    <div class="row mb-4">
        <div class="col-md-4">
            <form method="get" class="d-flex gap-2 bg-white p-2 rounded-3 shadow-sm border">
                <input type="month" name="mesFiltro" value="@ViewBag.MesFiltro" class="form-control border-0">
                <button type="submit" class="btn btn-zeta-cyan text-white rounded-2 px-4">
                    Filtrar
                </button>
            </form>
        </div>
    </div>


    <div class="row mb-4">
        <div class="col-md-6">
            <div class="card bg-success text-white shadow border-0" style="border-radius: 15px;">
                <div class="card-body text-center p-4">
                    <h5 class="opacity-75 small text-uppercase">Ingresos del Mes</h5>
                    <h1 class="display-4 fw-bold">$@ViewBag.TotalIngresos?.ToString("N0")</h1>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card bg-info text-white shadow border-0" style="border-radius: 15px;">
                <div class="card-body text-center p-4">
                    <h5 class="opacity-75 small text-uppercase">Pedidos del Mes</h5>
                    <h1 class="display-4 fw-bold">@ViewBag.CantidadPedidos</h1>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-8 mb-4">
            <div class="card shadow-sm p-4 border-0 h-100" style="border-radius: 15px;">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h5 class="fw-bold text-zeta-dark">@ViewBag.TituloGrafico</h5>
                    <div class="btn-group btn-group-sm shadow-sm">
                        <a asp-action="Index" asp-route-tipo="diario" asp-route-mesFiltro="@ViewBag.MesFiltro" class="btn @(ViewBag.TipoActivo == "diario" ? "btn-zeta-cyan text-white" : "btn-outline-secondary")">Diario</a>
                        <a asp-action="Index" asp-route-tipo="semanal" asp-route-mesFiltro="@ViewBag.MesFiltro" class="btn @(ViewBag.TipoActivo == "semanal" ? "btn-zeta-cyan text-white" : "btn-outline-secondary")">Semanal</a>
                        <a asp-action="Index" asp-route-tipo="mensual" asp-route-mesFiltro="@ViewBag.MesFiltro" class="btn @(ViewBag.TipoActivo == "mensual" ? "btn-zeta-cyan text-white" : "btn-outline-secondary")">Mensual</a>
                    </div>
                </div>
                <canvas id="graficoVentas" height="150"></canvas>
            </div>
        </div>

        <div class="col-lg-4 mb-4">
            <div class="card shadow-sm p-4 border-0 h-100" style="border-radius: 15px;">
                <h5 class="fw-bold text-zeta-dark text-center mb-4">Categorías Vendidas</h5>
                <canvas id="graficoCategorias"></canvas>
                <div id="sinDatosCategorias" class="text-center text-muted mt-5 d-none">
                    <i class="fa-solid fa-chart-pie fa-3x mb-2 opacity-25"></i>
                    <p>Sin ventas en este mes</p>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    function actualizarReporte() {
        const mes = document.getElementById('filtroMes').value;
        window.location.href = `/Reports/Index?tipo=@ViewBag.TipoActivo&mesFiltro=${mes}`;
    }

    // Gráfico de Líneas
    new Chart(document.getElementById('graficoVentas'), {
        type: 'line',
        data: {
            labels: @Html.Raw(Json.Serialize(ViewBag.Etiquetas)),
            datasets: [{
                data: @Html.Raw(Json.Serialize(ViewBag.Valores)),
                borderColor: '#17A09C',
                backgroundColor: 'rgba(23, 160, 156, 0.1)',
                fill: true,
                tension: 0.3
            }]
        },
        options: { plugins: { legend: { display: false } } }
    });

    // Gráfico de Torta
    const catLabels = @Html.Raw(Json.Serialize(ViewBag.CategoriasEtiquetas));
    if(catLabels.length === 0) {
        document.getElementById('graficoCategorias').style.display = 'none';
        document.getElementById('sinDatosCategorias').classList.remove('d-none');
    } else {
        new Chart(document.getElementById('graficoCategorias'), {
            type: 'doughnut',
            data: {
                labels: catLabels,
                datasets: [{
                    data: @Html.Raw(Json.Serialize(ViewBag.CategoriasValores)),
                    backgroundColor: ['#17A09C', '#FF6B6B', '#FFD93D', '#6BCB77', '#4D96FF']
                }]
            },
            options: { plugins: { legend: { position: 'bottom' } }, cutout: '65%' }
        });
    }
</script>