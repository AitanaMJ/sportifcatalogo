@using MyStoreLaZeta.Utilities;

@{
    int cartCount = 0;

    var cart = Context.Session.Get<List<CartItemVM>>("Cart");
    if (cart != null)
    {
        cartCount = cart.Sum(x => x.Quantity);
    }
}

    <a class="cart-link d-flex align-items-center"
       asp-controller="Home"
       asp-action="ViewCart">

        <i class="fa-solid fa-cart-shopping"></i>

        <span class="cart-badge @(cartCount == 0 ? "empty" : "")">
            @cartCount
        </span>

        </a>
